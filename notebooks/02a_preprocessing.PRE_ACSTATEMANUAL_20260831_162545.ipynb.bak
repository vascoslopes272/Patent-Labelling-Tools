    "import json\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "\n",
    "def _drop_ghost_image_blocks(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Step 0 — drop stale duplicate rows within an image block.\n",
    "\n",
    "    The wizard can leave a stub behind when a figure is re-keyed (same\n",
    "    Patent_ID + \"Image: <file>\" Sub_Dimension, same Field appearing twice\n",
    "    with different values). Blocks are written in save order, so the LAST\n",
    "    occurrence is the current one — keep it, drop earlier ones.\n",
    "    \"\"\"\n",
    "    df = df.copy()\n",
    "    is_img = df[\"Sub_Dimension\"].astype(str).str.startswith(\"Image: \")\n",
    "    key_cols = [\"Patent_ID\", \"Sub_Dimension\", \"Field\"]\n",
    "    dup_mask = is_img & df.duplicated(subset=key_cols, keep=\"last\")\n",
    "    if dup_mask.any():\n",
    "        ghost_patents = df.loc[dup_mask, \"Patent_ID\"].unique().tolist()\n",
    "        df = df.loc[~dup_mask].reset_index(drop=True)\n",
    "        _append_flag(df, ghost_patents, \"Stale image block removed;\")\n",
    "    return df\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# TR — architecture code 'TP' renamed 'TR' (Tilt Rotor) to match the codebook.\n",
    "#\n",
    "# Runs on EVERY batch, not just the legacy ones. Batch_02 was labelled on a wizard\n",
    "# that still wrote 'TP' (63 records); Batch_01 has 58 and Batch_05 37. The wizard\n",
    "# maps TP->TR on LOAD, so anything re-saved through it is already correct — but a\n",
    "# batch that never gets reloaded (which is every batch, normally) keeps the old\n",
    "# code, and then topType is not comparable across the corpus. 158 records total.\n",
    "#\n",
    "# Value is the \"ID — Label\" composite, so both halves are rewritten.\n",
    "TR_VALUE = \"TR — Vectored Thrust — Tilt Rotor\"\n",
    "\n",
    "\n",
    "def _rename_tp_to_tr(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Rename architecture code TP -> TR wherever it appears as a topType value.\"\"\"\n",
    "    df = df.copy()\n",
    "    mask = (df[\"Field\"] == \"topType\") & (df[\"Value\"].map(_strip_label) == \"TP\")\n",
    "    if mask.any():\n",
    "        ids = df.loc[mask, \"Patent_ID\"].unique().tolist()\n",
    "        df.loc[mask, \"Value\"] = TR_VALUE\n",
    "        _append_flag(df, ids, \"topType TP → TR (codebook rename);\")\n",
    "        print(f\"TR: {int(mask.sum())} topType row(s) renamed TP → TR \"\n",
    "              f\"across {len(ids)} architecture record(s)\")\n",
    "    else:\n",
    "        print(\"TR: no 'TP' topType values found — nothing to rename\")\n",
    "    # imgApparentArch mirrors the topType vocabulary, so it carries the old code too.\n",
    "    m2 = (df[\"Field\"] == \"imgApparentArch\") & (df[\"Value\"].map(_strip_label) == \"TP\")\n",
    "    if m2.any():\n",
    "        df.loc[m2, \"Value\"] = TR_VALUE\n",
    "        print(f\"TR: {int(m2.sum())} imgApparentArch row(s) also renamed\")\n",
    "\n",
    "    # labelToken is the wizard's one-line summary of a patent, built by gluing its\n",
    "    # main labels together with \"_\" — the architecture code is one of those\n",
    "    # components:\n",
    "    #     ArchitecturalSubsystemEnabler_TP_W×1_Conventional_FUS:Circular_LSYM\n",
    "    # Renaming topType alone left 54 Batch_01 tokens (63 on Batch_02, 37 on\n",
    "    # Batch_05) still carrying \"TP\", a code the taxonomy no longer has. Only a\n",
    "    # component that is EXACTLY \"TP\" is renamed: every other component is a\n",
    "    # prefixed or compound token (W×1, W1:…, FUS:…, LSYM, BOOMx2) or an empennage\n",
    "    # name (Tailless, Conventional, T-Tail…), so a bare \"TP\" can only be the\n",
    "    # architecture code.\n",
    "    def _tp_to_tr_token(tok):\n",
    "        return \"_\".join(\"TR\" if p == \"TP\" else p for p in str(tok).split(\"_\"))\n",
    "\n",
    "    m3 = df[\"Field\"] == \"labelToken\"\n",
    "    if m3.any():\n",
    "        _before = df.loc[m3, \"Value\"].astype(str)\n",
    "        df.loc[m3, \"Value\"] = _before.map(_tp_to_tr_token)\n",
    "        _n = int((_before != df.loc[m3, \"Value\"].astype(str)).sum())\n",
    "        if _n:\n",
    "            print(f\"TR: {_n} labelToken(s) also renamed TP → TR\")\n",
    "    return df\n",
    "\n",
    "\n",
    "PIPELINE_RULES = [\n",
    "    (\"0 — Ghost-block cleanup\",          _drop_ghost_image_blocks),\n",
    "    (\"TR — topType TP → TR codebook rename (all batches)\", _rename_tp_to_tr),\n",
    "    (\"A — Combined Thrust (flag for Section 5)\", _flag_combined_thrust),\n",
    "    (\"C — UAVSimilar duplicate-chain propagation (Bug-2 fix: D3 excluded as destination)\", _propagate_duplicate_tag),\n",
    "    (\"D — Duplicate inheritance (topType/isApproved)\", _inherit_from_duplicate_root),\n",
    "    (\"A1 — Fixed-arch acState auto-set to HoverCruise (Bug-1 fix pt.1)\", _force_hovercruise_fixed_arch),\n",
    "    (\"E — acState Ground → Other (Bug-1 fix pt.2: convertible-arch only)\", _remap_ground_to_other),\n",
    "    (\"New — multi-architecture aircraftName_perArch suffix (Part C)\", _suffix_multiarch_aircraft_names),\n",
    "    (\"BC — boom<N>_count True/False → 1/0 (all batches)\", _normalise_boom_group_counts),\n",
    "]\n",
    "\n",
    "_DIFF_COLS = [\"Section\", \"Sub_Dimension\", \"Field\", \"Value\"]\n",
    "\n",
    "\n",
    "def _patent_rows(df: pd.DataFrame, pid: str) -> pd.DataFrame:\n",
    "    return df.loc[df[\"Patent_ID\"].astype(str) == pid]\n",
    "\n",
    "\n",
    "def _flags_of(df: pd.DataFrame, pid: str) -> set:\n",
    "    if \"pre_process_flags\" not in df.columns:\n",
    "        return set()\n",
    "    vals = _patent_rows(df, pid)[\"pre_process_flags\"].fillna(\"\").astype(str)\n",
    "    out = set()\n",
    "    for v in vals:\n",
    "        out |= {m.strip() for m in v.split(\";\") if m.strip()}\n",
    "    return out\n",
    "\n",
    "\n",
    "def _affected_patents(before: pd.DataFrame, after: pd.DataFrame) -> list:\n",
    "    \"\"\"Patent ids whose rows OR flags differ between before and after.\"\"\"\n",
    "    def sig(d):\n",
    "        cols = [c for c in _DIFF_COLS]\n",
    "        out = {}\n",
    "        for pid, g in d.groupby(d[\"Patent_ID\"].astype(str)):\n",
    "            rows = sorted(map(tuple, g[cols].astype(str).values))\n",
    "            flags = tuple(sorted(_flags_of(d, pid)))\n",
    "            out[pid] = (tuple(rows), flags)\n",
    "        return out\n",
    "    b, a = sig(before), sig(after)\n",
    "    return sorted(pid for pid in set(b) | set(a) if b.get(pid) != a.get(pid))\n",
    "\n",
    "\n",
    "# Human-readable names for the field ids labellers actually see in the widget.\n",
    "# Falls back to the raw field id (still readable, just less pretty) for\n",
    "# anything not listed here, so a new field never breaks the description.\n",
    "_FIELD_LABELS = {\n",
    "    \"topType\": \"Architecture (topType)\", \"empTilts\": \"Empennage Tilts\",\n",
    "    \"empKin\": \"Empennage Kinematics (old)\", \"figKey\": \"Figure Number\",\n",
    "    \"status\": \"Image Approval Status\", \"isMain\": \"Main Figure\",\n",
    "    \"acState\": \"Flight State\", \"boomXFormat\": \"Booms X-Formation\",\n",
    "    \"boomNotes\": \"Booms Notes\", \"duplicateType\": \"Duplicate Type\",\n",
    "    \"isApproved\": \"Patent Approved\", \"isDuplicate\": \"Is Duplicate\",\n",
    "    \"duplicateId\": \"Duplicate Of (Patent ID)\", \"t1EdgeTags\": \"Edge-Case Tags\",\n",
    "    \"fusKin\": \"Fuselage Kinematics\", \"wCount\": \"Wing Count\",\n",
    "    \"latSym\": \"Laterally Symmetric\", \"longSym\": \"Longitudinally Symmetric\",\n",
    "    \"qualityFlag\": \"Figure Quality Flag\", \"acSty\": \"Aircraft Rendering Style\",\n",
    "    \"per\": \"View / Perspective\", \"acCol\": \"Aircraft Colour\",\n",
    "    \"bgSty\": \"Background Style\", \"bgCol\": \"Background Colour\",\n",
    "    \"parts\": \"Parts Shown\", \"rotation_deg\": \"Rotated\", \"arch\": \"Belongs to Architecture #\",\n",
    "    \"aircraftName\": \"Aircraft Name\", \"aircraftName_perArch\": \"Aircraft Name (this architecture)\",\n",
    "    \"propKin\": \"Propulsor Kinematics\", \"empNotes\": \"Empennage Notes\",\n",
    "}\n",
    "\n",
    "\n",
    "def _field_label(field: str) -> str:\n",
    "    if field in _FIELD_LABELS:\n",
    "        return _FIELD_LABELS[field]\n",
    "    if field.endswith(\"_propKin\"):\n",
    "        card = field[: -len(\"_propKin\")].replace(\"_\", \" \").title()\n",
    "        return f\"{card} — Propulsor Kinematics\"\n",
    "    if field.endswith(\"_count\"):\n",
    "        card = field[: -len(\"_count\")].replace(\"_\", \" \").title()\n",
    "        return f\"{card} — Count per side\"\n",
    "    return field\n",
    "\n",
    "\n",
    "def _show_val(v) -> str:\n",
    "    \"\"\"Display form of a cell value — an empty/NaN one reads as '(not answered)',\n",
    "    not as the literal string 'nan' the astype(str) diff produces.\"\"\"\n",
    "    s = \"\" if v is None else str(v).strip()\n",
    "    return \"(not answered)\" if s.lower() in {\"\", \"nan\", \"none\", \"nat\", \"<na>\"} else s\n",
    "\n",
    "\n",
    "def _describe_change_items(before: pd.DataFrame, after: pd.DataFrame, pid: str) -> list:\n",
    "    \"\"\"Per-patent diff as a list of RECORDS, one per thing the rule would do.\n",
    "\n",
    "    Each record is {\"kind\", \"text\", \"html\"}: \"text\" is the plain one-liner used\n",
    "    for logs, \"html\" is what the widget shows as a bullet. Field ids are\n",
    "    translated to plain names (_field_label), and the ghost-block case gets a\n",
    "    proper OLD-vs-KEPT comparison table (_ghost_block_html) instead of a\n",
    "    paragraph — \"removed, nothing added\" rows for the SAME image block are one\n",
    "    superseded entry going away, and listing its fields as separate cryptic\n",
    "    \"− ...\" lines reads like data loss.\n",
    "    \"\"\"\n",
    "    from collections import Counter\n",
    "    b = _patent_rows(before, pid)[_DIFF_COLS].astype(str)\n",
    "    a = _patent_rows(after, pid)[_DIFF_COLS].astype(str)\n",
    "    bc, ac = Counter(map(tuple, b.values)), Counter(map(tuple, a.values))\n",
    "    removed = list((bc - ac).elements())\n",
    "    added = list((ac - bc).elements())\n",
    "\n",
    "    recs = []\n",
    "    rem_by_key = {}\n",
    "    for sec, sub, field, val in removed:\n",
    "        rem_by_key.setdefault((sec, sub, field), []).append(val)\n",
    "    for sec, sub, field, val in added:\n",
    "        olds = rem_by_key.get((sec, sub, field))\n",
    "        label = _field_label(field)\n",
    "        where = f\" (on {sub})\" if str(sub).startswith(\"Image: \") else \"\"\n",
    "        if olds:\n",
    "            old = olds.pop(0)\n",
    "            recs.append({\n",
    "                \"kind\": \"changed\",\n",
    "                \"text\": f\"Change {label}{where}: '{_show_val(old)}' → '{_show_val(val)}'\",\n",
    "                \"html\": (f\"<b>Change {_html_escape(label)}</b>{_html_escape(where)}: \"\n",
    "                         f\"<span style='color:#b45309;text-decoration:line-through'>{_html_escape(_show_val(old))}</span>\"\n",
    "                         f\" &nbsp;→&nbsp; <b style='color:#15803d'>{_html_escape(_show_val(val))}</b>\"),\n",
    "            })\n",
    "            if not olds:\n",
    "                del rem_by_key[(sec, sub, field)]\n",
    "        else:\n",
    "            recs.append({\n",
    "                \"kind\": \"added\",\n",
    "                \"text\": f\"Add {label}{where} = '{_show_val(val)}' (no answer there today)\",\n",
    "                \"html\": (f\"<b style='color:#15803d'>Add</b> {_html_escape(label)}{_html_escape(where)} = \"\n",
    "                         f\"<b style='color:#15803d'>{_html_escape(_show_val(val))}</b> \"\n",
    "                         f\"<span style='color:#6b7280'>(there is no answer there today)</span>\"),\n",
    "            })\n",
    "\n",
    "    # Group whatever's left (removed with no matching add) by (Section, Sub_Dimension).\n",
    "    leftover_by_block = {}\n",
    "    for (sec, sub, field), olds in rem_by_key.items():\n",
    "        for val in olds:\n",
    "            leftover_by_block.setdefault((sec, sub), []).append((field, val))\n",
    "\n",
    "    for (sec, sub), field_vals in leftover_by_block.items():\n",
    "        if sub.startswith(\"Image: \") and len(field_vals) > 1:\n",
    "            # Same figure file can appear twice in the raw export when a labeller\n",
    "            # re-keys/re-reviews it later in a separate session — the OLD entry\n",
    "            # (usually incomplete/disapproved) is what's removed here. Look up the\n",
    "            # CURRENT entry for the same image so the two can be shown side by side\n",
    "            # and it's obvious the later, real review survives untouched.\n",
    "            surviving = after.loc[\n",
    "                (after[\"Patent_ID\"].astype(str) == pid)\n",
    "                & (after[\"Section\"] == sec) & (after[\"Sub_Dimension\"] == sub)]\n",
    "            recs.append(_ghost_block_record(sub, field_vals, surviving))\n",
    "        else:\n",
    "            for field, val in field_vals:\n",
    "                label = _field_label(field)\n",
    "                recs.append({\n",
    "                    \"kind\": \"removed\",\n",
    "                    \"text\": f\"Delete the answer {label} (currently '{_show_val(val)}')\",\n",
    "                    \"html\": (f\"<b style='color:#b45309'>Delete</b> the answer \"\n",
    "                             f\"<b>{_html_escape(label)}</b> \"\n",
    "                             f\"<span style='color:#6b7280'>(currently \"\n",
    "                             f\"'{_html_escape(_show_val(val))}')</span>\"),\n",
    "                })\n",
    "\n",
    "    for f in sorted(_flags_of(after, pid) - _flags_of(before, pid)):\n",
    "        flag = f.rstrip(\";\")\n",
    "        recs.append({\n",
    "            \"kind\": \"flag\",\n",
    "            \"text\": (f'Write the note \"{flag}\" into this patent\\'s pre_process_flags '\n",
    "                     f\"column (audit trail only — no label changes)\"),\n",
    "            \"html\": (f\"<span style='color:#6b7280'>Write the note \"\n",
    "                     f\"<b>“{_html_escape(flag)}”</b> into this patent's \"\n",
    "                     f\"<code>pre_process_flags</code> column — an audit trail of what this \"\n",
    "                     f\"notebook did. <b>No label is changed by this.</b></span>\"),\n",
    "        })\n",
    "    return recs\n",
    "\n",
    "\n",
    "def _ghost_block_record(sub: str, field_vals: list, surviving: pd.DataFrame) -> dict:\n",
    "    \"\"\"OLD-vs-KEPT comparison for one superseded image block (Ghost-block cleanup).\n",
    "\n",
    "    field_vals are the (field, value) pairs about to be deleted; `surviving` is\n",
    "    what stays behind for the same image. Rendered as a small table so it's\n",
    "    visible at a glance which answers die and which are untouched.\n",
    "    \"\"\"\n",
    "    file_name = sub[len(\"Image: \"):] if sub.startswith(\"Image: \") else sub\n",
    "    surv = {}\n",
    "    if surviving is not None and not surviving.empty:\n",
    "        for f, v in zip(surviving[\"Field\"].astype(str), surviving[\"Value\"].astype(str)):\n",
    "            surv.setdefault(f, v)\n",
    "\n",
    "    plain = \", \".join(f\"{_field_label(f)} '{_show_val(v)}'\"\n",
    "                      + (f\" (the kept entry says '{_show_val(surv[f])}')\" if f in surv else \"\")\n",
    "                      for f, v in field_vals)\n",
    "    if surv:\n",
    "        text = (f\"The figure {file_name} was answered TWICE — delete the older, abandoned \"\n",
    "                f\"answers ({plain}). The newer, complete entry for the same figure is kept \"\n",
    "                f\"exactly as it is.\")\n",
    "    else:\n",
    "        text = (f\"Delete the only answers left for the figure {file_name} ({plain}) — \"\n",
    "                f\"NO other entry for it survives, check this is not real data loss.\")\n",
    "\n",
    "    th = (\"padding:3px 8px;text-align:left;font-size:11px;text-transform:uppercase;\"\n",
    "          \"letter-spacing:.03em;border-bottom:1px solid #e5e7eb\")\n",
    "    td = \"padding:3px 8px;vertical-align:top\"\n",
    "    body = \"\".join(\n",
    "        f\"<tr><td style='{td};color:#374151'>{_html_escape(_field_label(f))}</td>\"\n",
    "        f\"<td style='{td};color:#b45309;text-decoration:line-through'>{_html_escape(_show_val(v))}</td>\"\n",
    "        f\"<td style='{td};color:#15803d'><b>{_html_escape(_show_val(surv[f]) if f in surv else '— (no such answer)')}</b></td></tr>\"\n",
    "        for f, v in field_vals)\n",
    "    extra = [f for f in surv if f not in {f for f, _ in field_vals}]\n",
    "    if extra:\n",
    "        names = \", \".join(_field_label(f) for f in extra[:4])\n",
    "        more = f\" and {len(extra) - 4} more\" if len(extra) > 4 else \"\"\n",
    "        body += (f\"<tr><td colspan='3' style='{td};color:#6b7280;font-size:11px'>\"\n",
    "                 f\"…plus {len(extra)} further answer(s) on the kept entry \"\n",
    "                 f\"({_html_escape(names)}{more}) — untouched.</td></tr>\")\n",
    "\n",
    "    if surv:\n",
    "        lead = (\"<b>This figure was answered twice.</b> The older, abandoned entry is \"\n",
    "                \"deleted; the newer, complete one you finished is kept exactly as it is.\")\n",
    "        warn = \"\"\n",
    "    else:\n",
    "        lead = \"<b style='color:#b91c1c'>This deletes the only entry for this figure.</b>\"\n",
    "        warn = (\"<div style='color:#b91c1c;margin-top:4px'>No other entry for this image \"\n",
    "                \"survives — check this is not real data loss before applying.</div>\")\n",
    "\n",
    "    html = (\n",
    "        f\"<div style='border:1px solid #e5e7eb;border-radius:5px;padding:8px;background:#fafafa'>\"\n",
    "        f\"<div style='margin-bottom:4px'>{lead}</div>\"\n",
    "        f\"<div style='font-family:monospace;font-size:11px;color:#6b7280;margin-bottom:6px'>\"\n",
    "        f\"{_html_escape(file_name)}</div>\"\n",
    "        f\"<table style='border-collapse:collapse;font-size:12px'><tr>\"\n",
    "        f\"<th style='{th}'></th>\"\n",
    "        f\"<th style='{th};color:#b45309'>Old entry → deleted</th>\"\n",
    "        f\"<th style='{th};color:#15803d'>Newer entry → kept</th></tr>{body}</table>\"\n",
    "        f\"{warn}<div style='color:#6b7280;font-size:11px;margin-top:6px'>\"\n",
    "        f\"Nothing else about this patent changes.</div></div>\")\n",
    "    return {\"kind\": \"ghost\", \"text\": text, \"html\": html}\n",
    "\n",
    "\n",
    "def _describe_change(before: pd.DataFrame, after: pd.DataFrame, pid: str) -> str:\n",
    "    \"\"\"Flat, one-line form of _describe_change_items (logging / non-widget use).\"\"\"\n",
    "    items = _describe_change_items(before, after, pid)\n",
    "    return \"; \".join(r[\"text\"] for r in items) if items else \"(no visible change)\"\n",
    "\n",
    "\n",
    "def _merge_selected(before: pd.DataFrame, after: pd.DataFrame, selected: set) -> pd.DataFrame:\n",
    "    \"\"\"Take `after`'s rows for selected patents, `before`'s for everyone else,\n",
    "    restoring the original patent order (rules only ever touch a patent's own\n",
    "    rows, so per-patent row swapping is safe).\"\"\"\n",
    "    for d in (before, after):\n",
    "        if \"pre_process_flags\" not in d.columns:\n",
    "            d[\"pre_process_flags\"] = \"\"\n",
    "    b_pid = before[\"Patent_ID\"].astype(str)\n",
    "    a_pid = after[\"Patent_ID\"].astype(str)\n",
    "    merged = pd.concat([before[~b_pid.isin(selected)], after[a_pid.isin(selected)]],\n",
    "                       ignore_index=True)\n",
    "    order = {pid: i for i, pid in enumerate(dict.fromkeys(b_pid))}\n",
    "    merged[\"_o\"] = merged[\"Patent_ID\"].astype(str).map(lambda p: order.get(p, len(order)))\n",
    "    merged = merged.sort_values(\"_o\", kind=\"stable\").drop(columns=\"_o\").reset_index(drop=True)\n",
    "    return merged\n",
    "\n",
    "\n",
    "\n",
    "# ── thumbnails for the confirmation rows ─────────────────────────────────────\n",
    "from io import BytesIO\n",
    "from html import escape as _html_escape\n",
    "from PIL import Image as _PILImage\n",
    "\n",
    "_PIPELINE_MATCHED_DIR = Path(cfg[\"paths\"][\"matched\"]) / sheet_name\n",
    "_THUMB_CACHE: dict = {}\n",
    "\n",
    "\n",
    "def _t2_image_for_patent(df: pd.DataFrame, patent_id: str):\n",
    "    \"\"\"Best (Image_Path, label) for THIS architecture's OWN reviewed T2 data.\n",
    "\n",
    "    Multi-architecture patents keep every T2 (figure) row on the BASE\n",
    "    patent id only — \"_arch2\"/\"_arch3\" ids carry no T2 rows of their own —\n",
    "    but each figure block IS tagged with which architecture it belongs to\n",
    "    (Field=\"arch\", values 1..N, matching parse_arch_id()'s arch number).\n",
    "    Filters to the figures actually tagged for this architecture first.\n",
    "\n",
    "    Returns (None, None) if this patent has no T2 rows at all (e.g. an\n",
    "    exact-duplicate patent, which by design was never independently\n",
    "    reviewed) — callers must NOT silently show a random disk file in that\n",
    "    case without labelling it as unreviewed (see _resolve_patent_image).\n",
    "    \"\"\"\n",
    "    base_id, arch_num = proc.parse_arch_id(patent_id)\n",
    "    t2 = df.loc[(df[\"Patent_ID\"].astype(str) == base_id) & (df[\"Section\"] == \"T2\")\n",
    "                & df[\"Image_Path\"].notna()]\n",
    "    if t2.empty:\n",
    "        return None, None\n",
    "\n",
    "    arch_tag_rows = df.loc[(df[\"Patent_ID\"].astype(str) == base_id) & (df[\"Field\"] == \"arch\")]\n",
    "    arch_by_block = arch_tag_rows.set_index(\"Sub_Dimension\")[\"Value\"]\n",
    "\n",
    "    def _arch_of(sub):\n",
    "        v = arch_by_block.get(sub)\n",
    "        try:\n",
    "            return int(_strip_label(v)) if v is not None and pd.notna(v) else None\n",
    "        except (TypeError, ValueError):\n",
    "            return None\n",
    "\n",
    "    t2 = t2.copy()\n",
    "    t2[\"_arch_tag\"] = t2[\"Sub_Dimension\"].map(_arch_of)\n",
    "    if t2[\"_arch_tag\"].notna().any():\n",
    "        this_arch = t2[t2[\"_arch_tag\"] == arch_num]\n",
    "        if not this_arch.empty:\n",
    "            t2 = this_arch  # else: nothing tagged for this arch — fall back to all figures below\n",
    "\n",
    "    is_main = t2.loc[(t2[\"Field\"] == \"isMain\")\n",
    "                     & t2[\"Value\"].astype(str).str.lower().isin([\"true\", \"1\", \"yes\", \"main\"]),\n",
    "                     \"Image_Path\"]\n",
    "    if not is_main.empty:\n",
    "        return Path(str(is_main.iloc[0])), \"✅ Approved main figure\"\n",
    "    any_path = t2[\"Image_Path\"].dropna()\n",
    "    if not any_path.empty:\n",
    "        return Path(str(any_path.iloc[0])), \"Reviewed figure (not marked main)\"\n",
    "    return None, None\n",
    "\n",
    "\n",
    "def _resolve_patent_image(df: pd.DataFrame, pid: str, matched_dir_root: Path):\n",
    "    \"\"\"(path_or_None, provenance_label) for the thumbnail/preview shown to\n",
    "    the reviewer — never silently passes off an unreviewed raw file as if\n",
    "    it were an approved figure.\n",
    "\n",
    "    Order: (1) this patent's own reviewed T2 data; (2) if it's a duplicate\n",
    "    with no T2 of its own (the normal case for duplicateType \"2\" — \"Images\n",
    "    AND aircraft the same\" — which is never independently reviewed by\n",
    "    design), follow duplicateId to the chain root and show THAT patent's\n",
    "    approved figure instead, clearly labelled as inherited; (3) only as a\n",
    "    last resort, an arbitrary raw file from disk, clearly labelled as\n",
    "    unreviewed so it can't be mistaken for an approved main image.\n",
    "    \"\"\"\n",
    "    path, label = _t2_image_for_patent(df, pid)\n",
    "    if path is not None:\n",
    "        return path, label\n",
    "\n",
    "    dup_rows = df.loc[(df[\"Patent_ID\"].astype(str) == pid) & (df[\"Field\"] == \"duplicateId\")\n",
    "                       & df[\"Value\"].notna() & (df[\"Value\"].astype(str).str.strip() != \"\")]\n",
    "    if not dup_rows.empty:\n",
    "        dup_target = df.loc[(df[\"Field\"] == \"duplicateId\") & df[\"Value\"].notna()]\n",
    "        dup_target = dup_target.set_index(dup_target[\"Patent_ID\"].astype(str))[\"Value\"]\n",
    "        root = _resolve_chain_root(pid, dup_target)\n",
    "        if root != pid:\n",
    "            root_path, root_label = _t2_image_for_patent(df, root)\n",
    "            if root_path is not None:\n",
    "                return root_path, f\"⚠ No figure of its own (duplicate) — showing ORIGINAL {root}'s {root_label.lower()}\"\n",
    "\n",
    "    base = pid.split(\"_arch\")[0]\n",
    "    try:\n",
    "        hits = sorted(matched_dir_root.glob(f\"{base}_*/*\"))\n",
    "    except OSError:\n",
    "        hits = []\n",
    "    if hits:\n",
    "        return hits[0], \"⚠ UNREVIEWED raw file from disk — NOT an approved figure\"\n",
    "    return None, None\n",
    "\n",
    "\n",
    "def _patent_thumbnail(df: pd.DataFrame, pid: str, max_px: int = 520):\n",
    "    \"\"\"(PNG bytes or None, provenance label or None) preview for pid, via\n",
    "    _resolve_patent_image — labelled so an unreviewed/inherited fallback is\n",
    "    never mistaken for an approved figure. max_px sets the LONG edge; the\n",
    "    short edge is whatever the image's real aspect ratio gives it (a fixed\n",
    "    width previously squashed wide landscape crops into thin strips).\n",
    "\n",
    "    Cached per (pid, max_px): the widget lets the reviewer change the preview\n",
    "    size, so a pid-only key would keep handing back the first size rendered.\"\"\"\n",
    "    key = (pid, max_px)\n",
    "    if key in _THUMB_CACHE:\n",
    "        return _THUMB_CACHE[key]\n",
    "    path, label = _resolve_patent_image(df, pid, _PIPELINE_MATCHED_DIR)\n",
    "    data = None\n",
    "    if path is not None and path.exists():\n",
    "        try:\n",
    "            im = _PILImage.open(path); im.thumbnail((max_px, max_px))\n",
    "            buf = BytesIO(); im.convert(\"RGB\").save(buf, \"PNG\")\n",
    "            data = buf.getvalue()\n",
    "        except Exception:\n",
    "            data = None\n",
    "    _THUMB_CACHE[key] = (data, label)\n",
    "    return data, label\n",
    "\n",
    "\n",
    "# ── plain-language help for each rule ────────────────────────────────────────\n",
    "# Keyed by the short code that starts each PIPELINE_RULES name (\"A1\", \"BC\", …):\n",
    "#   (headline, detail, (what ✔ APPLY does, what ✘ SKIP leaves behind))\n",
    "# Shown above the patent list so it's clear what a tick actually DOES — and what\n",
    "# the consequence of NOT ticking is — before ticking three hundred of them.\n",
    "_RULE_HELP = {\n",
    "    \"0\": (\"Delete the older of two answer sets for the same figure.\",\n",
    "          \"When a figure is re-keyed or re-reviewed in a later wizard session, the export \"\n",
    "          \"ends up with the SAME image file answered twice: the older, abandoned attempt \"\n",
    "          \"(usually half-filled and 'disapproved') and the newer, finished one. This deletes \"\n",
    "          \"the older attempt. Each patent below shows both side by side.\",\n",
    "          (\"delete the older, abandoned answers for that figure; the newer entry is kept \"\n",
    "           \"exactly as it is\",\n",
    "           \"keep both entries, so the export carries two conflicting answer sets for one \"\n",
    "           \"image file\")),\n",
    "    \"TR\": (\"Rename the old architecture code <code>TP</code> to <code>TR</code> (Tilt Rotor).\",\n",
    "           \"Codebook rename only. No label, image or approval is otherwise touched. The \"\n",
    "           \"wizard already writes TR; only batches labelled on an older wizard still say TP.\",\n",
    "           (\"rewrite this patent's architecture code as TR\",\n",
    "            \"leave TP, which no longer matches the codebook or the rest of the corpus\")),\n",
    "    \"A\": (\"Flag the patent for the Section 5 codebook queue (Combined Thrust / CVT).\",\n",
    "          \"Adds a flag only — this rule changes no label. You make the actual call later, \"\n",
    "          \"in Section 5, with the drawing in front of you.\",\n",
    "          (\"put this patent on the Section 5 CVT queue\",\n",
    "           \"leave it off that queue — it will not be raised again\")),\n",
    "    \"C\": (\"Copy the <code>UAVSimilar</code> edge-case tag across the duplicate chain.\",\n",
    "          \"If one patent in a chain of duplicates carries UAVSimilar, its partners describe \"\n",
    "          \"the same aircraft and should carry it too. Type-3 duplicates are never a destination.\",\n",
    "          (\"give this patent the UAVSimilar tag its duplicate partner already has\",\n",
    "           \"leave this patent untagged, so partners in one chain disagree\")),\n",
    "    \"D\": (\"Make a duplicate inherit <code>topType</code> and <code>isApproved</code> from its chain root.\",\n",
    "          \"The original at the root of the duplicate chain is the source of truth; a duplicate \"\n",
    "          \"is not independently reviewed, so it copies that original's architecture and approval.\",\n",
    "          (\"copy architecture / approval down from the original patent\",\n",
    "           \"leave the duplicate with its own (usually empty) values\")),\n",
    "    \"A1\": (\"Force flight state to <code>HoverCruise</code> on rigid (non-convertible) architectures.\",\n",
    "           \"A rigid architecture has a single flight state by definition, so any other value \"\n",
    "           \"there is a labelling slip rather than an observation about the drawing.\",\n",
    "           (\"set this patent's flight state to HoverCruise\",\n",
    "            \"keep the labeller's value, which the codebook says is impossible for this architecture\")),\n",
    "    \"E\": (\"Remap flight state <code>Ground</code> → <code>Other</code>, convertible architectures only.\",\n",
    "          \"<code>Ground</code> is not a valid state for these in the codebook. Rigid \"\n",
    "          \"architectures are handled by rule A1 instead, not here.\",\n",
    "          (\"change this patent's Ground to Other\",\n",
    "           \"keep Ground, which is not a valid codebook value here\")),\n",
    "    \"New\": (\"Append an architecture suffix to <code>aircraftName_perArch</code> on multi-architecture patents.\",\n",
    "            \"One patent can describe two or three different aircraft. Without the suffix, \"\n",
    "            \"arch 1 / arch 2 / arch 3 all share a single name downstream.\",\n",
    "            (\"give each architecture of this patent its own distinct name\",\n",
    "             \"let this patent's architectures keep sharing one name\")),\n",
    "    \"BC\": (\"Store boom-group counts as numbers (<code>1</code>/<code>0</code>) instead of <code>True</code>/<code>False</code>.\",\n",
    "           \"Format normalisation only — the count itself is unchanged.\",\n",
    "           (\"store this patent's boom counts as 1/0\",\n",
    "            \"leave True/False, which downstream code reads as text, not a count\")),\n",
    "}\n",
    "\n",
    "\n",
    "def _rule_help(name: str):\n",
    "    \"\"\"(headline, detail, (apply_means, skip_means)) for a PIPELINE_RULES name.\"\"\"\n",
    "    code = name.split(\"—\")[0].strip()\n",
    "    return _RULE_HELP.get(code, (\"(no plain-language description registered for this rule)\", \"\",\n",
    "                                 (\"apply this rule's change to the patent\",\n",
    "                                  \"leave the patent exactly as it is\")))\n",
    "\n",
    "\n",
    "def _row_caution(rule_code: str, before: pd.DataFrame, after: pd.DataFrame, pid: str):\n",
    "    \"\"\"Per-rule \"look at this one first\" warning, or None.\n",
    "\n",
    "    A patent that trips a caution starts on ✘ SKIP instead of ✔ APPLY, so the\n",
    "    rule never silently applies to a case that looks like bad input.\n",
    "\n",
    "    A1 (2026-08-24): a rigid architecture does not change configuration between\n",
    "    figures, so its figures cannot legitimately carry DIFFERENT flight states.\n",
    "    When they do, the honest reading is that the input is wrong — usually the\n",
    "    architecture label, sometimes the states — and forcing every figure to\n",
    "    HoverCruise would bury the evidence (both real examples found on Batch_01,\n",
    "    US2019144126A1 and US2017203839A1, are labelled MR but are drawn with a\n",
    "    wing, a tail and tilting ducts: they are not multirotors at all).\n",
    "    \"\"\"\n",
    "    if rule_code != \"A1\":\n",
    "        return None\n",
    "    rows = before.loc[(before[\"Patent_ID\"].astype(str) == pid) & (before[\"Field\"] == \"acState\")]\n",
    "    states = sorted({_strip_label(v) for v in rows[\"Value\"].dropna()} - {None, \"\"})\n",
    "    if len(states) < 2:\n",
    "        return None\n",
    "    tt = before.loc[(before[\"Patent_ID\"].astype(str) == pid) & (before[\"Field\"] == \"topType\"), \"Value\"]\n",
    "    arch = _strip_label(tt.iloc[0]) if len(tt) else \"?\"\n",
    "    return (f\"Its figures carry <b>{len(states)} different flight states</b> \"\n",
    "            f\"({', '.join(_html_escape(s) for s in states)}), but the architecture is \"\n",
    "            f\"labelled <b>{_html_escape(str(arch))}</b> — a rigid type, which by definition \"\n",
    "            f\"looks the same in hover and in cruise. One of the two labels is wrong. \"\n",
    "            f\"<b>Look at the drawings before applying;</b> if the aircraft really does \"\n",
    "            f\"transform, fix <code>topType</code> in the wizard instead of forcing the \"\n",
    "            f\"flight state here.\")\n",
    "\n",
    "\n",
    "def _change_bullet_html(rec) -> str:\n",
    "    \"\"\"One bullet of a per-patent diff — records carry their own markup.\"\"\"\n",
    "    if isinstance(rec, dict):\n",
    "        return rec.get(\"html\") or _html_escape(rec.get(\"text\", \"\"))\n",
    "    return _html_escape(str(rec))\n",
    "\n",
    "\n",
    "class RuleReviewPipeline:\n",
    "    \"\"\"Step through PIPELINE_RULES; every proposed change needs your tick.\n",
    "\n",
    "    The patent list is PAGED — only `page_size` patents are rendered at a time\n",
    "    and \"◀ Prev / Next ▶\" moves between groups, so the images can be shown big\n",
    "    enough to actually judge without a mile-long scroll. Ticks are remembered\n",
    "    for every patent of the current rule, on every page, until you press\n",
    "    \"Apply ticked\"; changing page/page size/image size never resets them.\n",
    "    \"\"\"\n",
    "\n",
    "    PAGE_SIZES = [1, 2, 3, 4, 6, 10, 25]\n",
    "    IMG_SIZES = [(\"Small — 320 px\", 320), (\"Medium — 520 px\", 520),\n",
    "                 (\"Large — 720 px\", 720), (\"Huge — 1000 px\", 1000)]\n",
    "\n",
    "    def __init__(self, df: pd.DataFrame, rules=None, auto_apply: bool = False,\n",
    "                 page_size: int = 4, img_px: int = 520):\n",
    "        self.df = df.copy()\n",
    "        self.rules = list(rules or PIPELINE_RULES)\n",
    "        self.step = 0\n",
    "        self.finished = False\n",
    "        self.auto_apply = auto_apply   # True → apply every rule to every patent, no widget\n",
    "        self._after = None\n",
    "        self._boxes = {}        # pid -> ToggleButton, for EVERY affected patent of this rule\n",
    "        self._rows = {}         # pid -> HBox, built lazily for the page being looked at\n",
    "        self._affected = []     # ordered patent ids for the current rule\n",
    "        self._cautions = {}     # pid -> \"why this one needs a second look\" (or None)\n",
    "        self._pos = {}          # pid -> 1-based position in _affected\n",
    "        # Rule decisions are the ONE thing in this notebook with nowhere to live:\n",
    "        # Section 4 never writes to the corrected working copy (that file is the\n",
    "        # record of human labelling; rule output is derived and is re-computed every\n",
    "        # run), and it cannot be read back from the export either — the export is\n",
    "        # filtered, so feeding it in would permanently drop the disapproved figures\n",
    "        # and duplicate rows it left out. So the per-patent ticks go to a sidecar:\n",
    "        # deterministic rule output stays derived, only the human's SKIP choices are\n",
    "        # remembered. Restored below in _render_step.\n",
    "        self.decisions_path = (Path(cfg[\"paths\"][\"base\"]) / \"data\" / \"03b_CONFORMED_legacy\"\n",
    "                               / \"proposals\" / f\"rule_decisions_{sheet_name}.json\")\n",
    "        self._saved = self._load_decisions()\n",
    "        self.page = 0\n",
    "        self.page_size = page_size\n",
    "        self.img_px = img_px\n",
    "        self._suspend = False   # guards the \"jump to page\" box against feedback loops\n",
    "\n",
    "        self.title = widgets.HTML()\n",
    "        self.legend = widgets.HTML(\n",
    "            \"<div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;\"\n",
    "            \"padding:8px 10px;font-size:13px;line-height:1.65'>\"\n",
    "            \"<b>How to read this list.</b> One row = <b>one patent</b> this rule wants to change.\"\n",
    "            \"<br>&nbsp;&nbsp;<b style='color:#15803d'>✔ APPLY</b> (green, the default) — let the \"\n",
    "            \"rule make the change listed on that row.\"\n",
    "            \"<br>&nbsp;&nbsp;<b style='color:#b45309'>✘ SKIP</b> (grey) — make no change to that \"\n",
    "            \"patent; it stays exactly as the labeller left it.\"\n",
    "            \"<br>The box above the list says, for this rule, what each of those two choices means.\"\n",
    "            \"<br>Click a row's button to flip it. <b>Nothing is written</b> until you press \"\n",
    "            \"<b>Apply ticked → next rule</b>. <b>Skip this rule</b> leaves every patent in the \"\n",
    "            \"rule untouched and moves on.</div>\")\n",
    "        self.counter = widgets.HTML()\n",
    "        self.log = widgets.HTML()\n",
    "\n",
    "        # bulk tick controls — page-scoped and rule-scoped kept visibly separate\n",
    "        self.tick_page_btn = widgets.Button(description=\"✔ Tick this page\", layout=widgets.Layout(width=\"150px\"))\n",
    "        self.untick_page_btn = widgets.Button(description=\"✘ Untick this page\", layout=widgets.Layout(width=\"150px\"))\n",
    "        self.all_btn = widgets.Button(description=\"✔ Tick ALL patents\", layout=widgets.Layout(width=\"160px\"))\n",
    "        self.none_btn = widgets.Button(description=\"✘ Untick ALL patents\", layout=widgets.Layout(width=\"160px\"))\n",
    "        self.tick_page_btn.on_click(lambda b: self._set_all(True, scope=\"page\"))\n",
    "        self.untick_page_btn.on_click(lambda b: self._set_all(False, scope=\"page\"))\n",
    "        self.all_btn.on_click(lambda b: self._set_all(True))\n",
    "        self.none_btn.on_click(lambda b: self._set_all(False))\n",
    "\n",
    "        # the two commit buttons exist twice (top and bottom of the page) so a\n",
    "        # long page never leaves them off-screen\n",
    "        def _mk_actions():\n",
    "            ap = widgets.Button(description=\"Apply ticked → next rule\", button_style=\"success\",\n",
    "                                layout=widgets.Layout(width=\"230px\"))\n",
    "            sk = widgets.Button(description=\"Skip this rule (change nothing)\", button_style=\"warning\",\n",
    "                                layout=widgets.Layout(width=\"230px\"))\n",
    "            ap.on_click(self._on_apply)\n",
    "            sk.on_click(self._on_skip)\n",
    "            return ap, sk\n",
    "\n",
    "        self.apply_btn, self.skip_btn = _mk_actions()\n",
    "        self.apply_btn2, self.skip_btn2 = _mk_actions()\n",
    "\n",
    "        # paging controls, also duplicated top and bottom\n",
    "        self.page_size_dd = widgets.Dropdown(options=self.PAGE_SIZES, value=self.page_size,\n",
    "                                             description=\"Per page:\",\n",
    "                                             layout=widgets.Layout(width=\"160px\"),\n",
    "                                             style={\"description_width\": \"70px\"})\n",
    "        self.img_dd = widgets.Dropdown(options=self.IMG_SIZES, value=self.img_px,\n",
    "                                       description=\"Image size:\",\n",
    "                                       layout=widgets.Layout(width=\"230px\"),\n",
    "                                       style={\"description_width\": \"80px\"})\n",
    "        self.page_size_dd.observe(self._on_page_size, names=\"value\")\n",
    "        self.img_dd.observe(self._on_img_size, names=\"value\")\n",
    "\n",
    "        self.prev_btn, self.next_btn, self.page_lbl, self.jump = self._mk_nav(with_jump=True)\n",
    "        self.prev_btn2, self.next_btn2, self.page_lbl2, _ = self._mk_nav(with_jump=False)\n",
    "        self.nav_top = widgets.HBox(\n",
    "            [self.prev_btn, self.page_lbl, self.next_btn, self.jump, self.page_size_dd, self.img_dd],\n",
    "            layout=widgets.Layout(align_items=\"center\", flex_flow=\"row wrap\",\n",
    "                                  border=\"1px solid #e2e8f0\", padding=\"4px\", margin=\"6px 0 0 0\"))\n",
    "        self.nav_bottom = widgets.HBox(\n",
    "            [self.prev_btn2, self.page_lbl2, self.next_btn2],\n",
    "            layout=widgets.Layout(align_items=\"center\", border=\"1px solid #e2e8f0\", padding=\"4px\"))\n",
    "\n",
    "        self.list_box = widgets.VBox(\n",
    "            layout=widgets.Layout(border=\"1px solid #ccc\", padding=\"6px\", width=\"100%\"))\n",
    "\n",
    "        self.root = widgets.VBox([\n",
    "            self.title,\n",
    "            self.legend,\n",
    "            self.counter,\n",
    "            widgets.HBox([self.tick_page_btn, self.untick_page_btn,\n",
    "                          widgets.HTML(\"&nbsp;&nbsp;\"), self.all_btn, self.none_btn],\n",
    "                         layout=widgets.Layout(flex_flow=\"row wrap\")),\n",
    "            widgets.HBox([self.apply_btn, self.skip_btn], layout=widgets.Layout(margin=\"6px 0 0 0\")),\n",
    "            self.nav_top,\n",
    "            self.list_box,\n",
    "            self.nav_bottom,\n",
    "            widgets.HBox([self.apply_btn2, self.skip_btn2], layout=widgets.Layout(margin=\"0 0 6px 0\")),\n",
    "            self.log,\n",
    "        ])\n",
    "        self._render_step()\n",
    "\n",
    "    # ── paging plumbing ──────────────────────────────────────────────────────\n",
    "    def _mk_nav(self, with_jump: bool):\n",
    "        prev = widgets.Button(description=\"◀ Prev\", layout=widgets.Layout(width=\"100px\"))\n",
    "        nxt = widgets.Button(description=\"Next ▶\", layout=widgets.Layout(width=\"100px\"))\n",
    "        lbl = widgets.HTML(layout=widgets.Layout(min_width=\"330px\"))\n",
    "        prev.on_click(lambda b: self._goto(self.page - 1))\n",
    "        nxt.on_click(lambda b: self._goto(self.page + 1))\n",
    "        jump = None\n",
    "        if with_jump:\n",
    "            jump = widgets.BoundedIntText(value=1, min=1, max=1, description=\"Go to page:\",\n",
    "                                          layout=widgets.Layout(width=\"150px\"),\n",
    "                                          style={\"description_width\": \"80px\"})\n",
    "            jump.observe(lambda ch: self._goto(int(ch[\"new\"]) - 1), names=\"value\")\n",
    "        return prev, nxt, lbl, jump\n",
    "\n",
    "    def _n_pages(self) -> int:\n",
    "        if not self._affected:\n",
    "            return 1\n",
    "        return max(1, -(-len(self._affected) // max(1, self.page_size)))\n",
    "\n",
    "    def _goto(self, page: int):\n",
    "        if self._suspend:\n",
    "            return\n",
    "        self.page = max(0, min(page, self._n_pages() - 1))\n",
    "        self._render_page()\n",
    "\n",
    "    def _on_page_size(self, change):\n",
    "        first = self.page * self.page_size          # keep the current top patent in view\n",
    "        self.page_size = int(change[\"new\"])\n",
    "        self.page = first // max(1, self.page_size)\n",
    "        self._render_page()\n",
    "\n",
    "    def _on_img_size(self, change):\n",
    "        self.img_px = int(change[\"new\"])\n",
    "        self._rows = {}                              # thumbnails are size-specific\n",
    "        self._render_page()\n",
    "\n",
    "    def _set_all(self, value, scope: str = \"all\"):\n",
    "        pids = self._page_pids() if scope == \"page\" else list(self._boxes)\n",
    "        for pid in pids:\n",
    "            self._boxes[pid].value = value\n",
    "\n",
    "    def _page_pids(self):\n",
    "        lo = self.page * self.page_size\n",
    "        return self._affected[lo:lo + self.page_size]\n",
    "\n",
    "    def _update_counter(self):\n",
    "        n = len(self._boxes)\n",
    "        on = sum(1 for b in self._boxes.values() if b.value)\n",
    "        self.counter.value = (\n",
    "            f\"<div style='padding:6px 0;font-size:14px'>\"\n",
    "            f\"<b style='color:#15803d'>{on}</b> patent(s) will be <b>changed</b> \"\n",
    "            f\"&nbsp;·&nbsp; <b style='color:#b45309'>{n - on}</b> will be left \"\n",
    "            f\"<b>untouched</b> &nbsp;·&nbsp; {n} in this rule.</div>\")\n",
    "\n",
    "    # ── one patent row ───────────────────────────────────────────────────────\n",
    "    def _row_for(self, pid: str):\n",
    "        if pid in self._rows:\n",
    "            return self._rows[pid]\n",
    "        box = self._boxes[pid]\n",
    "        status = widgets.HTML()\n",
    "\n",
    "        thumb, thumb_label = _patent_thumbnail(self.df, pid, max_px=self.img_px)\n",
    "        if thumb:\n",
    "            img = widgets.Image(value=thumb, format=\"png\",\n",
    "                                layout=widgets.Layout(max_width=f\"{self.img_px}px\",\n",
    "                                                      max_height=f\"{self.img_px}px\"))\n",
    "            warn = bool(thumb_label) and thumb_label.startswith(\"⚠\")\n",
    "            cap = widgets.HTML(\n",
    "                f\"<span style='font-size:11px;{'background:#fef3c7;padding:2px 4px;' if warn else ''}\"\n",
    "                f\"color:{'#b45309' if warn else '#555'}'>{_html_escape(thumb_label or '')}</span>\")\n",
    "            img_col = widgets.VBox([img, cap],\n",
    "                                   layout=widgets.Layout(flex=f\"0 0 {self.img_px + 24}px\",\n",
    "                                                         align_items=\"flex-start\"))\n",
    "        else:\n",
    "            img_col = widgets.HTML(\"<i style='color:#999'>no image</i>\",\n",
    "                                   layout=widgets.Layout(flex=f\"0 0 {self.img_px + 24}px\"))\n",
    "\n",
    "        caution = self._cautions.get(pid)\n",
    "        caution_html = (f\"<div style='background:#fef3c7;border-left:4px solid #f59e0b;\"\n",
    "                        f\"padding:6px 8px;margin:0 0 8px;font-size:13px;line-height:1.6'>\"\n",
    "                        f\"⚠ <b>Check this one before applying.</b> {caution}</div>\"\n",
    "                        if caution else \"\")\n",
    "        items = _describe_change_items(self.df, self._after, pid)\n",
    "        items_html = \"\".join(f\"<li style='margin-bottom:6px'>{_change_bullet_html(m)}</li>\"\n",
    "                             for m in items) or \"<li><i>(no visible change)</i></li>\"\n",
    "        text_w = widgets.HTML(\n",
    "            f\"<div style='font-size:13px;color:#6b7280'>patent {self._pos[pid]} of {len(self._affected)}</div>\"\n",
    "            f\"<div style='font-family:monospace;font-size:16px;margin-bottom:6px'><b>{_html_escape(pid)}</b></div>\"\n",
    "            f\"{caution_html}\"\n",
    "            f\"<div style='font-size:13px'><b>Left on ✔ APPLY, this rule will:</b></div>\"\n",
    "            f\"<ul style='margin:4px 0 0 18px;padding:0;font-size:13px;line-height:1.55'>{items_html}</ul>\",\n",
    "            layout=widgets.Layout(margin=\"0 0 0 12px\", min_width=\"300px\", flex=\"1 1 auto\"))\n",
    "\n",
    "        # One INDEPENDENT HBox per patent (not a shared GridBox) — each row lays\n",
    "        # itself out with no cross-row height-sharing, which is what broke:\n",
    "        # GridBox's row height came from its tallest cell, but different figures\n",
    "        # have very different aspect ratios, so rows ended up misaligned between\n",
    "        # the image and text columns. widgets.Image (not a raw HTML <img>, which\n",
    "        # VSCode collapsed to scrollbar bars) + explicit flex-basis per column\n",
    "        # (the fix that stopped the image container stretching past its image).\n",
    "        row = widgets.HBox(\n",
    "            [widgets.VBox([box, status], layout=widgets.Layout(flex=\"0 0 170px\")), img_col, text_w],\n",
    "            layout=widgets.Layout(align_items=\"flex-start\", border_bottom=\"1px solid #eee\",\n",
    "                                  padding=\"12px 8px\", margin=\"0 0 8px 0\", width=\"100%\"))\n",
    "\n",
    "        def _sync(_change=None):\n",
    "            on = box.value\n",
    "            box.description = \"✔ APPLY\" if on else \"✘ SKIP\"\n",
    "            box.button_style = \"success\" if on else \"\"\n",
    "            box.tooltip = (\"Ticked: this rule's change WILL be applied to this patent.\"\n",
    "                           if on else\n",
    "                           \"Unticked: this patent stays exactly as the labeller left it.\")\n",
    "            status.value = (\n",
    "                \"<div style='font-size:11px;color:#15803d;padding:4px 0 0 2px'>\"\n",
    "                \"will be <b>changed</b></div>\" if on else\n",
    "                \"<div style='font-size:11px;color:#b45309;padding:4px 0 0 2px'>\"\n",
    "                \"left <b>as labelled</b></div>\")\n",
    "            row.layout.border_left = \"5px solid #16a34a\" if on else \"5px solid #d4d4d4\"\n",
    "            self._update_counter()\n",
    "\n",
    "        box.observe(_sync, names=\"value\")\n",
    "        _sync()\n",
    "        self._rows[pid] = row\n",
    "        return row\n",
    "\n",
    "    # ── rendering ────────────────────────────────────────────────────────────\n",
    "    def _render_page(self):\n",
    "        pids = self._page_pids()\n",
    "        self.list_box.children = [self._row_for(p) for p in pids]\n",
    "        n, npages = len(self._affected), self._n_pages()\n",
    "        lo = self.page * self.page_size + 1\n",
    "        hi = min(n, (self.page + 1) * self.page_size)\n",
    "        lbl = (f\"<div style='padding:0 10px;font-size:13px'>Showing patents \"\n",
    "               f\"<b>{lo}–{hi}</b> of <b>{n}</b> &nbsp;·&nbsp; page <b>{self.page + 1}</b> \"\n",
    "               f\"of <b>{npages}</b></div>\")\n",
    "        self.page_lbl.value = self.page_lbl2.value = lbl\n",
    "        first, last = self.page == 0, self.page >= npages - 1\n",
    "        self.prev_btn.disabled = self.prev_btn2.disabled = first\n",
    "        self.next_btn.disabled = self.next_btn2.disabled = last\n",
    "        self._suspend = True\n",
    "        try:\n",
    "            self.jump.max = npages\n",
    "            self.jump.value = self.page + 1\n",
    "        finally:\n",
    "            self._suspend = False\n",
    "        self._update_counter()\n",
    "\n",
    "    def _render_step(self):\n",
    "        while self.step < len(self.rules):\n",
    "            name, fn = self.rules[self.step]\n",
    "            self._after = fn(self.df)\n",
    "            affected = _affected_patents(self.df, self._after)\n",
    "            if not affected:\n",
    "                self.log.value += f\"<div>• <b>{name}</b>: nothing to change — auto-skipped.</div>\"\n",
    "                self.step += 1\n",
    "                continue\n",
    "            if self.auto_apply:\n",
    "                self.df = _merge_selected(self.df, self._after, set(affected))\n",
    "                self.log.value += (f\"<div>• <b>{name}</b>: AUTO-applied to \"\n",
    "                                   f\"{len(affected)} patent(s) (headless).</div>\")\n",
    "                print(f\"  [headless] {name}: auto-applied to {len(affected)} patent(s)\")\n",
    "                self.step += 1\n",
    "                continue\n",
    "\n",
    "            # cautions first: the header reports how many rows start on SKIP\n",
    "            code = name.split(\"—\")[0].strip()\n",
    "            self._cautions = {pid: _row_caution(code, self.df, self._after, pid)\n",
    "                              for pid in affected}\n",
    "            n_caution = sum(1 for c in self._cautions.values() if c)\n",
    "\n",
    "            head, detail, (apply_means, skip_means) = _rule_help(name)\n",
    "            self.title.value = (\n",
    "                f\"<div style='font-size:15px'><b>Step {self.step + 1} of {len(self.rules)}</b> \"\n",
    "                f\"&nbsp;·&nbsp; <span style='font-family:monospace'>{_html_escape(name)}</span></div>\"\n",
    "                f\"<div style='margin:8px 0 2px;font-size:14px'><b>What this rule does:</b> {head}</div>\"\n",
    "                f\"<div style='color:#555;font-size:13px;line-height:1.55'>{detail}</div>\"\n",
    "                f\"<div style='margin:8px 0 0;padding:6px 10px;background:#f8fafc;\"\n",
    "                f\"border-left:4px solid #cbd5e1;font-size:13.5px;line-height:1.75'>\"\n",
    "                f\"On each patent below:<br>\"\n",
    "                f\"&nbsp;&nbsp;<b style='color:#15803d'>✔ APPLY</b> → {apply_means}.<br>\"\n",
    "                f\"&nbsp;&nbsp;<b style='color:#b45309'>✘ SKIP</b> → {skip_means}.</div>\"\n",
    "                f\"<div style='margin:8px 0 0;font-size:14px'><b>{len(affected)}</b> patent(s) \"\n",
    "                f\"would change — set to APPLY by default, so <b>switch to SKIP only what you \"\n",
    "                f\"do NOT want changed</b>.</div>\"\n",
    "                + (f\"<div style='margin:6px 0 0;padding:6px 10px;background:#fef3c7;\"\n",
    "                   f\"border-left:4px solid #f59e0b;font-size:13.5px'>⚠ <b>{n_caution} of them \"\n",
    "                   f\"look like bad input and start on ✘ SKIP</b> — their rows say why. Nothing \"\n",
    "                   f\"happens to them unless you switch them to APPLY yourself.</div>\"\n",
    "                   if n_caution else \"\"))\n",
    "\n",
    "            self._affected = affected\n",
    "            self._pos = {pid: i + 1 for i, pid in enumerate(affected)}\n",
    "            self._rows = {}\n",
    "            # Checkboxes for EVERY affected patent are created up front (cheap) so\n",
    "            # ticks survive paging; only the visible page's rows — and therefore\n",
    "            # only the visible page's thumbnails — are actually built.\n",
    "            # A patent seen in the last pass re-opens on that decision; one that is\n",
    "            # new since then falls back to the caution default (SKIP if flagged).\n",
    "            _prev = self._saved.get(name, {})\n",
    "            _prev_skip, _prev_appl = set(_prev.get(\"skipped\", [])), set(_prev.get(\"applied\", []))\n",
    "            def _initial(pid):\n",
    "                if str(pid) in _prev_skip:\n",
    "                    return False\n",
    "                if str(pid) in _prev_appl:\n",
    "                    return True\n",
    "                return not self._cautions[pid]\n",
    "            self._boxes = {\n",
    "                pid: widgets.ToggleButton(value=_initial(pid), description=\"✔ APPLY\",\n",
    "                                          button_style=\"success\",\n",
    "                                          layout=widgets.Layout(width=\"150px\"))\n",
    "                for pid in affected}\n",
    "            _restored = sum(1 for pid in affected\n",
    "                            if str(pid) in _prev_skip or str(pid) in _prev_appl)\n",
    "            if _restored:\n",
    "                _n_skip = sum(1 for pid in affected if str(pid) in _prev_skip)\n",
    "                self.title.value += (\n",
    "                    f\"<div style='margin:6px 0 0;padding:6px 10px;background:#eff6ff;\"\n",
    "                    f\"border-left:4px solid #3b82f6;font-size:13.5px'>↺ <b>{_restored} of these \"\n",
    "                    f\"carry your decision from the last run</b>\"\n",
    "                    + (f\", {_n_skip} of them on ✘ SKIP\" if _n_skip else \"\")\n",
    "                    + f\". Nothing to re-decide — press <b>Apply ticked → next rule</b> \"\n",
    "                      f\"unless something has changed.</div>\")\n",
    "            self.page = 0\n",
    "            self._render_page()\n",
    "            return\n",
    "        self._finish()\n",
    "\n",
    "    def _load_decisions(self) -> dict:\n",
    "        \"\"\"{rule name: {\"applied\": [pid], \"skipped\": [pid]}} from the last pass.\"\"\"\n",
    "        if not self.decisions_path.exists():\n",
    "            return {}\n",
    "        try:\n",
    "            saved = json.loads(self.decisions_path.read_text())\n",
    "        except Exception as exc:\n",
    "            print(f\"⚠ could not read {self.decisions_path.name} ({exc}) — starting fresh\")\n",
    "            return {}\n",
    "        n_skip = sum(len(v.get(\"skipped\", [])) for v in saved.values())\n",
    "        print(f\"rule memory: {len(saved)} rule(s) restored from {self.decisions_path.name}\"\n",
    "              f\" — {n_skip} patent(s) will re-open on ✘ SKIP\")\n",
    "        return saved\n",
    "\n",
    "    def _save_decisions(self, name, applied, skipped):\n",
    "        rec = dict(self._saved)\n",
    "        rec[name] = {\"applied\": sorted(map(str, applied)),\n",
    "                     \"skipped\": sorted(map(str, skipped)),\n",
    "                     \"saved_utc\": datetime.now(timezone.utc).isoformat(timespec=\"seconds\")}\n",
    "        self.decisions_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "        self.decisions_path.write_text(json.dumps(rec, indent=1))\n",
    "        self._saved = rec\n",
    "\n",
    "    def _on_apply(self, _btn):\n",
    "        name, _ = self.rules[self.step]\n",
    "        selected = {pid for pid, box in self._boxes.items() if box.value}\n",
    "        self.df = _merge_selected(self.df, self._after, selected)\n",
    "        n_rej = len(self._boxes) - len(selected)\n",
    "        self._save_decisions(name, selected, set(self._boxes) - selected)\n",
    "        self.log.value += (f\"<div>• <b>{name}</b>: applied to {len(selected)} patent(s)\"\n",
    "                           + (f\", rejected {n_rej}\" if n_rej else \"\") + \".</div>\")\n",
    "        self.step += 1\n",
    "        self._render_step()\n",
    "\n",
    "    def _on_skip(self, _btn):\n",
    "        name, _ = self.rules[self.step]\n",
    "        self._save_decisions(name, set(), set(self._boxes))\n",
    "        self.log.value += f\"<div>• <b>{name}</b>: skipped (nothing applied).</div>\"\n",
    "        self.step += 1\n",
    "        self._render_step()\n",
    "\n",
    "    def _finish(self):\n",
    "        self.finished = True\n",
    "        self.title.value = (\"<h4>✅ All rules reviewed.</h4>Run the next cell: \"\n",
    "                            \"<code>df = pipeline.result()</code>\")\n",
    "        self.legend.value = \"\"\n",
    "        self.counter.value = \"\"\n",
    "        self.list_box.children = []\n",
    "        self.page_lbl.value = self.page_lbl2.value = \"\"\n",
    "        for w in (self.apply_btn, self.skip_btn, self.apply_btn2, self.skip_btn2,\n",
    "                  self.all_btn, self.none_btn, self.tick_page_btn, self.untick_page_btn,\n",
    "                  self.prev_btn, self.next_btn, self.prev_btn2, self.next_btn2,\n",
    "                  self.jump, self.page_size_dd, self.img_dd):\n",
    "            w.disabled = True\n",
    "\n",
    "    def result(self) -> pd.DataFrame:\n",
    "        assert self.finished, \"Finish reviewing all rules in the widget first.\"\n",
    "        return self.df.copy()\n",
    "\n",
    "    def display(self):\n",
    "        display(self.root)\n",
    "\n",
    "\n",
    "pipeline = RuleReviewPipeline(df, auto_apply=HEADLESS)\n",
    "if HEADLESS:\n",
    "    print(\"HEADLESS: all rules auto-applied above — no widget to click.\")\n",
    "else:\n",
    "    pipeline.display()"
   ]
  },
