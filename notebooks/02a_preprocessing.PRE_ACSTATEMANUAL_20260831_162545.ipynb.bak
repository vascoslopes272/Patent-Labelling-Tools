   "source": [
    "import subprocess, tempfile, os\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "\n",
    "_BLOCKERS_JS = repo_root / \"scripts\" / \"completeness\" / \"blockers_one.js\"\n",
    "_WIZARD_HTML = Path(cfg[\"paths\"][\"html_template\"])\n",
    "_BLOCK_OUT = (Path(cfg[\"paths\"][\"base\"]) / \"data\" / \"03b_CONFORMED_legacy\" / \"proposals\"\n",
    "              / f\"wizard_blockers_{sheet_name}.csv\")\n",
    "\n",
    "def _run_blockers(frame: pd.DataFrame, patents=None, workers: int = 8) -> pd.DataFrame:\n",
    "    \"\"\"Ask the wizard what each patent is still missing. Returns a tidy frame.\"\"\"\n",
    "    cols = [\"Patent_ID\", \"Section\", \"Sub_Dimension\", \"Field\", \"Value\", \"Source\", \"Image_Path\"]\n",
    "    f = frame[[c for c in cols if c in frame.columns]].copy()\n",
    "    f[\"_base\"] = f[\"Patent_ID\"].astype(str).str.replace(r\"_arch\\d+$\", \"\", regex=True)\n",
    "    todo = sorted(set(patents if patents is not None else f[\"_base\"]))\n",
    "    env = {**os.environ, \"WIZARD_HTML\": str(_WIZARD_HTML)}\n",
    "    rows = []\n",
    "    with tempfile.TemporaryDirectory() as td:\n",
    "        def one(pid):\n",
    "            p = Path(td) / f\"{pid}.json\"\n",
    "            p.write_text(f.loc[f[\"_base\"] == pid, cols].to_json(orient=\"records\"))\n",
    "            r = subprocess.run([\"node\", str(_BLOCKERS_JS), str(p)],\n",
    "                               capture_output=True, text=True, env=env)\n",
    "            try:\n",
    "                return json.loads(r.stdout)\n",
    "            except Exception:\n",
    "                return {\"pid\": pid, \"archs\": 0, \"blockers\": [],\n",
    "                        \"error\": (r.stderr or r.stdout or \"no output\")[:200]}\n",
    "        with ThreadPoolExecutor(max_workers=workers) as ex:\n",
    "            for d in ex.map(one, todo):\n",
    "                if d.get(\"error\"):\n",
    "                    rows.append(dict(Patent_ID=d[\"pid\"], arch=0, step=\"(error)\", blocker=d[\"error\"]))\n",
    "                for b in d[\"blockers\"]:\n",
    "                    rows.append(dict(Patent_ID=d[\"pid\"], arch=b[\"arch\"], step=b[\"step\"],\n",
    "                                     blocker=b[\"msg\"]))\n",
    "    return pd.DataFrame(rows, columns=[\"Patent_ID\", \"arch\", \"step\", \"blocker\"])\n",
    "\n",
    "\n",
    "# Same scope as the completeness check: approved, and not an exact (type-2) duplicate —\n",
    "# a type 2 legitimately carries no labels of its own.\n",
    "# df_raw is Section 3's untouched load — the human record. Deliberately NOT df:\n",
    "# Rule D inherits topType onto duplicates and A1/Part C add rows, which would\n",
    "# mask questions the reviewer never answered.\n",
    "_src = df_raw\n",
    "_appr = _src.loc[_src[\"Field\"] == \"isApproved\"]\n",
    "_appr_ids = set(_appr.loc[_appr[\"Value\"].astype(str) == \"True\", \"Patent_ID\"]\n",
    "                .astype(str).str.replace(r\"_arch\\d+$\", \"\", regex=True))\n",
    "_dt = _src.loc[_src[\"Field\"] == \"duplicateType\"]\n",
    "_dup2 = set(_dt.loc[_dt[\"Value\"].map(_strip_label) == \"2\", \"Patent_ID\"]\n",
    "            .astype(str).str.replace(r\"_arch\\d+$\", \"\", regex=True))\n",
    "_scope = sorted(_appr_ids - _dup2)\n",
    "\n",
    "if not _BLOCKERS_JS.exists():\n",
    "    print(f\"⚠ {_BLOCKERS_JS} not found — skipping the unanswered-question check\")\n",
    "elif subprocess.run([\"node\", \"--version\"], capture_output=True).returncode != 0:\n",
    "    print(\"⚠ node not on PATH — skipping the unanswered-question check\")\n",
    "else:\n",
    "    print(f\"asking the wizard ({_WIZARD_HTML.name}) what {len(_scope)} patent(s) are still \"\n",
    "          f\"missing — one Node process each, this takes a minute…\")\n",
    "    blockers = _run_blockers(_src, _scope)\n",
    "    _errs = blockers[blockers[\"step\"] == \"(error)\"]\n",
    "    _real = blockers[blockers[\"step\"] != \"(error)\"]\n",
    "    _npat = _real[\"Patent_ID\"].nunique()\n",
    "    print(f\"\\n{len(_real)} unanswered question(s) on {_npat} of {len(_scope)} patent(s) \"\n",
    "          f\"({len(_scope) - _npat} are complete)\")\n",
    "    if len(_errs):\n",
    "        print(f\"⚠ {len(_errs)} patent(s) could not be checked: \"\n",
    "              f\"{sorted(set(_errs.Patent_ID))[:5]}\")\n",
    "    if len(_real):\n",
    "        print(\"\\nby question (most common first):\")\n",
    "        for msg, n in _real[\"blocker\"].value_counts().items():\n",
    "            pats = sorted(set(_real.loc[_real[\"blocker\"] == msg, \"Patent_ID\"]))\n",
    "            print(f\"   {n:4}  {msg[:74]}\")\n",
    "            print(f\"         {', '.join(pats[:6])}{' …' if len(pats) > 6 else ''}\")\n",
    "        _BLOCK_OUT.parent.mkdir(parents=True, exist_ok=True)\n",
    "        _real.sort_values([\"Patent_ID\", \"arch\", \"step\"]).to_csv(_BLOCK_OUT, index=False)\n",
    "        print(f\"\\nworklist -> {_BLOCK_OUT.name}\")\n",
    "    else:\n",
    "        print(\"every patent answers every question the wizard would ask.\")\n"
   ]
  },
