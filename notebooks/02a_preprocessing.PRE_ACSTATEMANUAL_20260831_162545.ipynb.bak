   "source": [
    "import json\n",
    "import time\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display\n",
    "from ipyevents import Event\n",
    "\n",
    "from src.review_worklists import build_worklist, QUESTIONS\n",
    "\n",
    "DECISIONS_DIR = Path(cfg[\"paths\"][\"base\"]) / \"data\" / \"03b_CONFORMED_legacy\" / \"proposals\"\n",
    "DECISIONS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Absolute pixels, never percentages. The old panel here was\n",
    "# Output(layout=Layout(width=\"45%\")) with no height, so a figure drew at 45% of a narrow\n",
    "# column and the row collapsed. These are hover-vs-cruise comparisons — they have to be\n",
    "# side by side and they have to be big.\n",
    "FIG_W, GRID_W, GRID_H = 420, 900, 700\n",
    "\n",
    "\n",
    "class WorklistReview:\n",
    "    \"\"\"One decision at a time, every figure of the patent on screen at once.\"\"\"\n",
    "\n",
    "    def __init__(self, items, batch, decisions_csv=None):\n",
    "        self.batch = batch\n",
    "        self.csv = Path(decisions_csv or DECISIONS_DIR / f\"review_decisions_{batch}.csv\")\n",
    "        # Everything build_worklist() has EVER produced for this batch, uid -> item,\n",
    "        # figures included. build_worklist() only sees the CURRENT xlsx, so once a\n",
    "        # decision is applied (Section 5c writes the value) its trigger stops firing\n",
    "        # and the item vanishes from a fresh build — permanently, with no way back,\n",
    "        # unless something remembers it. This cache is that memory: merged in below,\n",
    "        # a resolved item stays reachable (and its figures stay viewable) through\n",
    "        # \"Include decided\" for as long as the file exists.\n",
    "        self.item_cache_path = self.csv.with_name(f\"worklist_items_cache_{batch}.json\")\n",
    "        cached_items = self._load_item_cache()\n",
    "        self._fresh_uids = {it[\"uid\"] for it in items}\n",
    "        self.decisions = {}\n",
    "        self.order = []          # uids, most recent last — drives undo\n",
    "        self._csv_mtime = -1.0\n",
    "        self._deleted = set()   # uids undo() removed — save() must not let a merge revive them\n",
    "        self._load_from_disk()\n",
    "        if self.decisions:\n",
    "            print(f\"resumed {len(self.decisions)} decision(s) from {self.csv.name}\")\n",
    "        # A cached item comes back ONLY if it has an actual recorded decision AND is\n",
    "        # no longer produced live — an item that just silently stopped triggering\n",
    "        # (edited outside the decide()/5c flow, with no decision on record) is not\n",
    "        # resurrected: nothing decided it, so there is nothing to review.\n",
    "        resolved = [cached_items[u] for u in self.decisions\n",
    "                   if u not in self._fresh_uids and u in cached_items]\n",
    "        if resolved:\n",
    "            print(f\"{len(resolved)} previously-decided item(s) resolved elsewhere \"\n",
    "                 f\"since last built — still viewable via 'Include decided'\")\n",
    "        self.items = list(items) + resolved\n",
    "        self._save_item_cache({**cached_items, **{it[\"uid\"]: it for it in items}})\n",
    "        self.cur = 0\n",
    "        self.focus = 0\n",
    "        self.include_decided = False\n",
    "        self._build()\n",
    "\n",
    "    def _load_item_cache(self) -> dict:\n",
    "        if not self.item_cache_path.exists():\n",
    "            return {}\n",
    "        try:\n",
    "            return {it[\"uid\"]: it for it in json.loads(self.item_cache_path.read_text())}\n",
    "        except Exception:\n",
    "            return {}   # a corrupt/partial cache file costs nothing but its own contents\n",
    "\n",
    "    def _save_item_cache(self, by_uid: dict):\n",
    "        self.item_cache_path.write_text(json.dumps(list(by_uid.values())))\n",
    "\n",
    "    def _load_from_disk(self):\n",
    "        \"\"\"Load/refresh self.decisions from the CSV.\n",
    "\n",
    "        Something other than THIS widget can add to that file between renders —\n",
    "        Section 5c applying decisions writes new values but leaves the CSV alone,\n",
    "        while a decision recorded straight into the CSV (by hand, or by a script)\n",
    "        never touches this object's memory at all. Re-checking the file's mtime on\n",
    "        every render picks both up automatically, without ever discarding a click\n",
    "        this widget itself just made: decide()/undo() always save() BEFORE\n",
    "        rendering, so this widget's own state is never behind what's on disk —\n",
    "        only an edit from elsewhere can make the file newer than what we last read.\n",
    "        \"\"\"\n",
    "        try:\n",
    "            mtime = self.csv.stat().st_mtime\n",
    "        except FileNotFoundError:\n",
    "            return\n",
    "        if mtime <= self._csv_mtime:\n",
    "            return\n",
    "        prev = pd.read_csv(self.csv) if self.csv.exists() else pd.DataFrame()\n",
    "        self.decisions = {r[\"uid\"]: r.to_dict() for _, r in prev.iterrows()}\n",
    "        # keep existing undo order for uids that survived; anything that showed\n",
    "        # up on disk without ever going through THIS widget's order goes on the\n",
    "        # end so undo still has something sane to pop.\n",
    "        self.order = [u for u in self.order if u in self.decisions] + \\\n",
    "                     [u for u in self.decisions if u not in self.order]\n",
    "        self._csv_mtime = mtime\n",
    "\n",
    "    # ── queue ────────────────────────────────────────────────────────────────\n",
    "    def todo(self):\n",
    "        return [i for i in self.items if i[\"uid\"] not in self.decisions]\n",
    "\n",
    "    def queue(self):\n",
    "        \"\"\"What Prev/Next walks. Undecided items only by default; every item when\n",
    "        'Include decided' is on, so an answer can be revisited and changed. Either\n",
    "        way the decisions themselves are untouched — this only changes what is\n",
    "        being stepped through.\"\"\"\n",
    "        return list(self.items) if self.include_decided else self.todo()\n",
    "\n",
    "    def item(self):\n",
    "        q = self.queue()\n",
    "        if not q:\n",
    "            return None\n",
    "        self.cur = max(0, min(self.cur, len(q) - 1))\n",
    "        return q[self.cur]\n",
    "\n",
    "    # ── layout ───────────────────────────────────────────────────────────────\n",
    "    def _build(self):\n",
    "        self.head = widgets.HTML()\n",
    "        # Buttons for what the n/p/u keys do — the keys only reach the widget while it\n",
    "        # holds DOM focus, which one click anywhere else in the notebook takes away.\n",
    "        self.prev_btn = widgets.Button(description=\"◀ Prev\", tooltip=\"previous UNDECIDED item (p) — use b to step back through decided ones\",\n",
    "                                       layout=widgets.Layout(width=\"110px\"))\n",
    "        self.next_btn = widgets.Button(description=\"Next ▶\", tooltip=\"next UNDECIDED item (n) — use f to step forward through decided ones\",\n",
    "                                       layout=widgets.Layout(width=\"110px\"))\n",
    "        self.undo_btn = widgets.Button(description=\"↩ Undo last\", tooltip=\"undo the most recent decision (u)\",\n",
    "                                       layout=widgets.Layout(width=\"130px\"))\n",
    "        self.decided_tgl = widgets.ToggleButton(\n",
    "            value=False, description=\"Include decided\",\n",
    "            tooltip=\"walk every item, including the ones already answered, so a decision can be changed\",\n",
    "            layout=widgets.Layout(width=\"160px\"))\n",
    "        self.pos = widgets.HTML(layout=widgets.Layout(min_width=\"300px\"))\n",
    "        self.back_hint = widgets.HTML()\n",
    "        self.prev_btn.on_click(lambda b: self.step(-1))\n",
    "        self.next_btn.on_click(lambda b: self.step(+1))\n",
    "        self.undo_btn.on_click(lambda b: self.undo())\n",
    "        self.decided_tgl.observe(self._toggle_decided, names=\"value\")\n",
    "        self.nav = widgets.HBox([self.prev_btn, self.next_btn, self.pos,\n",
    "                                 self.undo_btn, self.decided_tgl],\n",
    "                                layout=widgets.Layout(align_items=\"center\", flex_flow=\"row wrap\",\n",
    "                                                      padding=\"4px 0\", border_bottom=\"1px solid #eee\"))\n",
    "        self.figbox = widgets.Box(layout=widgets.Layout(\n",
    "            width=f\"{GRID_W}px\", min_height=f\"{GRID_H}px\", flex_flow=\"row wrap\",\n",
    "            align_content=\"flex-start\", overflow_y=\"auto\", border=\"1px solid #d0d0d0\"))\n",
    "        self.zoom = widgets.Box(layout=widgets.Layout(width=f\"{GRID_W}px\"))\n",
    "        self.qbox = widgets.HTML()\n",
    "        self.btns = widgets.VBox()\n",
    "        self.meta = widgets.HTML(layout=widgets.Layout(width=\"440px\"))\n",
    "        right = widgets.VBox([self.qbox, self.btns, self.meta],\n",
    "                             layout=widgets.Layout(width=\"460px\", margin=\"0 0 0 14px\"))\n",
    "        self.root = widgets.VBox(\n",
    "            [self.head, self.nav, self.back_hint, widgets.HBox([widgets.VBox([self.figbox, self.zoom]), right],\n",
    "                                     layout=widgets.Layout(align_items=\"flex-start\"))])\n",
    "        # ipyevents needs a focusable node; the container gets a tabindex so keydown\n",
    "        # lands here instead of scrolling the notebook.\n",
    "        self.root.add_class(\"worklist-root\")\n",
    "        self.ev = Event(source=self.root, watched_events=[\"keydown\"], prevent_default_action=True)\n",
    "        self.ev.on_dom_event(self._key)\n",
    "        self.render()\n",
    "\n",
    "    def _figures(self, it):\n",
    "        kids = []\n",
    "        for n, f in enumerate(it[\"figures\"]):\n",
    "            p = Path(f[\"path\"])\n",
    "            box = [widgets.HTML(f\"<div style='font:600 13px sans-serif;text-align:center;\"\n",
    "                                f\"padding:2px'>{f['fig']}{' ◀' if n == self.focus else ''}</div>\")]\n",
    "            if p.exists():\n",
    "                box.insert(0, widgets.Image(value=p.read_bytes(), format=p.suffix.lstrip(\".\") or \"png\",\n",
    "                                            layout=widgets.Layout(width=f\"{FIG_W}px\", height=\"auto\")))\n",
    "            else:\n",
    "                box.insert(0, widgets.HTML(\n",
    "                    f\"<div style='width:{FIG_W}px;height:180px;display:flex;align-items:center;\"\n",
    "                    f\"justify-content:center;background:#eee;color:#888'>image not on disk</div>\"))\n",
    "            kids.append(widgets.VBox(box, layout=widgets.Layout(\n",
    "                margin=\"6px\", border=(\"2px solid #1f77b4\" if n == self.focus else \"1px solid #ddd\"))))\n",
    "        return kids\n",
    "\n",
    "    def render(self):\n",
    "        self._load_from_disk()\n",
    "        it = self.item()\n",
    "        total, left = len(self.items), len(self.todo())\n",
    "        if it is None:\n",
    "            self.head.value = (f\"<h3 style='font-family:sans-serif'>Queue empty — \"\n",
    "                               f\"{total} decision(s) recorded.</h3>\"\n",
    "                               f\"<div style='color:#666'>Run Section 5c to apply them. Tick \"\n",
    "                               f\"<b>Include decided</b> to walk back through them.</div>\")\n",
    "            self.figbox.children, self.btns.children = (), ()\n",
    "            self.qbox.value = self.meta.value = \"\"\n",
    "            self.pos.value = \"\"\n",
    "            self.back_hint.value = \"\"\n",
    "            self.prev_btn.disabled = self.next_btn.disabled = True\n",
    "            self.undo_btn.disabled = not self.order\n",
    "            return\n",
    "        q = self.queue()\n",
    "        prev_dec = self.decisions.get(it[\"uid\"])\n",
    "        self.pos.value = (\n",
    "            f\"<div style='font:13px sans-serif;padding:0 10px'>item <b>{self.cur + 1}</b> of \"\n",
    "            f\"<b>{len(q)}</b> {'(all items)' if self.include_decided else '(undecided only)'}\"\n",
    "            f\" &nbsp;·&nbsp; {total - left} decided, {left} left</div>\")\n",
    "        self.prev_btn.disabled = self.cur == 0\n",
    "        self.next_btn.disabled = self.cur >= len(q) - 1\n",
    "        self.undo_btn.disabled = not self.order\n",
    "        # Prev greys out at cur==0 no matter which mode you're in — but in\n",
    "        # \"undecided only\" mode that can look like you're stuck, when what's\n",
    "        # actually true is there's nowhere to go WITHIN this filtered queue: the\n",
    "        # already-decided items aren't in it at all, not even behind you. Say so.\n",
    "        self.back_hint.value = (\n",
    "            f\"<div style='font:12px sans-serif;color:#b8860b;padding:2px 10px'>\"\n",
    "            f\"◀ Prev is grey because this queue only shows the {left} undecided items — \"\n",
    "            f\"the {total - left} you already answered aren't in it, not even earlier in it. \"\n",
    "            f\"Tick <b>Include decided</b> above to walk back through those.</div>\"\n",
    "            if (self.prev_btn.disabled and not self.include_decided and total - left > 0)\n",
    "            else \"\")\n",
    "        qd = QUESTIONS[it[\"q\"]]\n",
    "        self.head.value = (\n",
    "            f\"<div style='font:15px sans-serif;padding:6px 0'>\"\n",
    "            f\"<b style='font-size:20px'>{total-left}</b><span style='font-size:13px;\"\n",
    "            f\"color:#666'> of {total} decided</span>\"\n",
    "            f\" &nbsp;·&nbsp; <span style='color:#b8860b'>{it['q']} — {qd['label']}</span>\"\n",
    "            f\" &nbsp;·&nbsp; <code>{it['patent']}</code> ({it['batch']})\"\n",
    "            f\"{' · ' + it['slot'] if it['slot'] else ''}</div>\")\n",
    "        self.figbox.children = self._figures(it)\n",
    "        self.zoom.children = ()\n",
    "        is_resolved = prev_dec is not None and it[\"uid\"] not in self._fresh_uids\n",
    "        self.qbox.value = (\n",
    "            (f\"<div style='background:#fff3e0;border-left:3px solid #fb8c00;padding:6px 10px;\"\n",
    "             f\"font:13px sans-serif;margin-bottom:6px'>already decided: <b>{prev_dec['decision']}</b> \"\n",
    "             f\"— already applied to the file; picking a different option here needs Section 5c \"\n",
    "             f\"run again before it takes</div>\"\n",
    "             if is_resolved else\n",
    "             f\"<div style='background:#e8f5e9;border-left:3px solid #43a047;padding:6px 10px;\"\n",
    "             f\"font:13px sans-serif;margin-bottom:6px'>already decided: \"\n",
    "             f\"<b>{prev_dec['decision']}</b> — picking another option overwrites it</div>\"\n",
    "             if prev_dec else \"\")\n",
    "            + f\"<div style='font:600 17px sans-serif;margin-bottom:4px'>{it['title'][:110]}</div>\"\n",
    "            f\"<div style='background:#fff8e1;border-left:3px solid #f0b429;padding:8px 10px;\"\n",
    "            f\"font:14px sans-serif;white-space:pre-wrap'>{it['why']}</div>\")\n",
    "\n",
    "        # Only the field under question. >=15px. The value the record holds is marked.\n",
    "        rows = []\n",
    "        for n, (oid, prose) in enumerate(qd[\"options\"], 1):\n",
    "            is_cur = str(it[\"old\"]) == str(oid)\n",
    "            is_dec = bool(prev_dec) and str(prev_dec[\"decision\"]) == str(oid)\n",
    "            b = widgets.Button(description=f\"{n}. {prose}\"[:78],\n",
    "                               tooltip=f\"press {n}\",\n",
    "                               layout=widgets.Layout(width=\"440px\", height=\"auto\",\n",
    "                                                     margin=\"3px 0\"),\n",
    "                               style=dict(font_size=\"15px\",\n",
    "                                          button_color=(\"#c8e6c9\" if is_dec else\n",
    "                                                        \"#e8f0fe\" if is_cur else None)))\n",
    "            b.on_click(lambda _b, v=oid: self.decide(v))\n",
    "            rows.append(b)\n",
    "            if is_cur:\n",
    "                rows.append(widgets.HTML(\"<div style='font:12px sans-serif;color:#888;\"\n",
    "                                         \"margin:-2px 0 4px 6px'>▲ current value</div>\"))\n",
    "        self.btns.children = rows\n",
    "        self.meta.value = (\n",
    "            f\"<div style='font:13px sans-serif;color:#444'>\"\n",
    "            f\"<h4 style='margin:12px 0 2px'>Abstract</h4>\"\n",
    "            f\"<div style='max-height:150px;overflow:auto;white-space:pre-wrap'>{it['abstract'] or '—'}</div>\"\n",
    "            f\"<h4 style='margin:12px 0 2px'>Brief description of drawings</h4>\"\n",
    "            f\"<div style='max-height:170px;overflow:auto;white-space:pre-wrap'>{it['drawings'] or '—'}</div>\"\n",
    "            f\"<div style='margin-top:12px;color:#888'>1–{len(qd['options'])} decide · s skip · \"\n",
    "            f\"n/p move (or the Prev/Next buttons) · u undo · [ ] focus figure · e expand</div></div>\")\n",
    "\n",
    "    # ── actions ──────────────────────────────────────────────────────────────\n",
    "    def step(self, delta):\n",
    "        n = len(self.queue())\n",
    "        if n:\n",
    "            self.cur = max(0, min(self.cur + delta, n - 1))\n",
    "        self.focus = 0\n",
    "        self.render()\n",
    "\n",
    "    def step_full(self, delta):\n",
    "        \"\"\"Walk the FULL list, decided items included — what `b` / `f` do.\n",
    "\n",
    "        `n` / `p` step through queue(), which is the UNDECIDED items by default, so\n",
    "        the moment you answer something it leaves the queue and there is no way back\n",
    "        to it without reaching for the \"Include decided\" toggle. That is exactly when\n",
    "        you want to go back — you have just mis-keyed an answer. So b/f switch the\n",
    "        toggle on for you and step through every item. Its observer is suspended for\n",
    "        the assignment, or it would recompute `cur` underneath us and land somewhere\n",
    "        else. Re-answering simply overwrites the decision, as it always did.\n",
    "        \"\"\"\n",
    "        uids = [it[\"uid\"] for it in self.items]\n",
    "        if not uids:\n",
    "            return\n",
    "        cur_it = self.item()\n",
    "        idx = uids.index(cur_it[\"uid\"]) if cur_it is not None and cur_it[\"uid\"] in uids else 0\n",
    "        tgt_uid = uids[max(0, min(idx + delta, len(uids) - 1))]\n",
    "        if not self.include_decided:\n",
    "            self.include_decided = True\n",
    "            self.decided_tgl.unobserve(self._toggle_decided, names=\"value\")\n",
    "            self.decided_tgl.value = True\n",
    "            self.decided_tgl.observe(self._toggle_decided, names=\"value\")\n",
    "        q = [it[\"uid\"] for it in self.queue()]\n",
    "        self.cur = q.index(tgt_uid) if tgt_uid in q else 0\n",
    "        self.focus = 0\n",
    "        self.render()\n",
    "\n",
    "    def _toggle_decided(self, change):\n",
    "        \"\"\"Keep the item on screen when the queue it lives in changes size.\"\"\"\n",
    "        it = self.item()\n",
    "        self.include_decided = bool(change[\"new\"])\n",
    "        uids = [i[\"uid\"] for i in self.queue()]\n",
    "        self.cur = uids.index(it[\"uid\"]) if it is not None and it[\"uid\"] in uids else 0\n",
    "        self.focus = 0\n",
    "        self.render()\n",
    "\n",
    "    def decide(self, val):\n",
    "        it = self.item()\n",
    "        if it is None:\n",
    "            return\n",
    "        self._deleted.discard(it[\"uid\"])   # re-answering un-deletes it\n",
    "        self.decisions[it[\"uid\"]] = dict(\n",
    "            uid=it[\"uid\"], batch=it[\"batch\"], patent=it[\"patent\"], question=it[\"q\"],\n",
    "            slot=it[\"slot\"], sub_dim=it[\"sub_dim\"], field=QUESTIONS[it[\"q\"]][\"field\"] or \"\",\n",
    "            old_value=it[\"old\"], decision=val, decided_at=pd.Timestamp.utcnow().isoformat())\n",
    "        if it[\"uid\"] in self.order:      # re-deciding: one undo entry per item, not two\n",
    "            self.order.remove(it[\"uid\"])\n",
    "        self.order.append(it[\"uid\"])\n",
    "        self.save()                      # before anything else — crash-safe\n",
    "        self.focus = 0\n",
    "        if self.include_decided:         # the item stays in this queue, so move on ourselves\n",
    "            self.step(+1)\n",
    "            return\n",
    "        self.render()\n",
    "\n",
    "    def undo(self):\n",
    "        while self.order:\n",
    "            uid = self.order.pop()\n",
    "            if uid in self.decisions:\n",
    "                del self.decisions[uid]\n",
    "                self._deleted.add(uid)\n",
    "                self.save()\n",
    "                self.cur = 0\n",
    "                self.render()\n",
    "                return\n",
    "\n",
    "    def save(self):\n",
    "        \"\"\"Write self.decisions to disk — as a MERGE with whatever is on the file\n",
    "        right now, never a blind overwrite.\n",
    "\n",
    "        2026-08-25: a second, older WorklistReview instance (e.g. a browser tab\n",
    "        left open from an earlier run of this cell, or a kernel that never picked\n",
    "        up a later reload) can still be alive with a smaller, stale `self.decisions`\n",
    "        in memory. Its very first click used to overwrite the WHOLE file with just\n",
    "        its own stale dict, silently deleting every decision added by anything\n",
    "        else since that instance was built — including a decision this same\n",
    "        widget saved a minute ago in a different tab, or one written directly by\n",
    "        a script. This cost real, unrecoverable review work once already. Now:\n",
    "        read what's on disk, let `self.decisions` win only on uids IT actually\n",
    "        holds, keep everything else — so an overwrite can only ever ADD or\n",
    "        CHANGE what this instance actually decided, never erase what it didn't.\n",
    "        \"\"\"\n",
    "        on_disk = {}\n",
    "        if self.csv.exists():\n",
    "            try:\n",
    "                on_disk = {r[\"uid\"]: r.to_dict() for _, r in pd.read_csv(self.csv).iterrows()}\n",
    "            except Exception:\n",
    "                pass   # unreadable file — fall back to writing our own state alone\n",
    "        merged = {**on_disk, **self.decisions}\n",
    "        for uid in self._deleted:\n",
    "            merged.pop(uid, None)\n",
    "        pd.DataFrame(list(merged.values())).to_csv(self.csv, index=False)\n",
    "        self.decisions = merged     # adopt anything recovered from disk too\n",
    "        self._csv_mtime = self.csv.stat().st_mtime\n",
    "\n",
    "    def _key(self, e):\n",
    "        # Debounce. One keydown was reaching this handler several times, so a single\n",
    "        # press answered 2-4 consecutive items — 7 such decisions are on file from\n",
    "        # 2026-08-25, recorded 40-80ms apart when the fastest gap a human actually\n",
    "        # typed is 580ms. Anything arriving within 250ms of the last handled key is\n",
    "        # a repeat, not a second press.\n",
    "        _now = time.monotonic()\n",
    "        if _now - getattr(self, \"_last_key_t\", 0.0) < 0.25:\n",
    "            return\n",
    "        self._last_key_t = _now\n",
    "\n",
    "        k = str(e.get(\"key\", \"\")).lower()\n",
    "        it = self.item()\n",
    "        if k == \"b\":\n",
    "            self.step_full(-1)\n",
    "            return\n",
    "        if k == \"f\":\n",
    "            self.step_full(+1)\n",
    "            return\n",
    "        if k.isdigit() and k != \"0\" and it is not None:\n",
    "            opts = QUESTIONS[it[\"q\"]][\"options\"]\n",
    "            if int(k) <= len(opts):\n",
    "                self.decide(opts[int(k) - 1][0])\n",
    "        elif k == \"s\":\n",
    "            self.decide(\"__skip__\")\n",
    "        elif k == \"n\":\n",
    "            self.step(+1)\n",
    "        elif k == \"p\":\n",
    "            self.step(-1)\n",
    "        elif k == \"u\":\n",
    "            self.undo()\n",
    "        elif k in (\"[\", \"]\") and it is not None and it[\"figures\"]:\n",
    "            self.focus = (self.focus + (1 if k == \"]\" else -1)) % len(it[\"figures\"])\n",
    "            self.render()\n",
    "        elif k == \"e\" and it is not None and it[\"figures\"]:\n",
    "            f = it[\"figures\"][self.focus]\n",
    "            p = Path(f[\"path\"])\n",
    "            self.zoom.children = ([widgets.Image(value=p.read_bytes(),\n",
    "                                                 format=p.suffix.lstrip(\".\") or \"png\",\n",
    "                                                 layout=widgets.Layout(width=f\"{GRID_W}px\"))]\n",
    "                                  if p.exists() else ())\n",
    "\n",
    "    def show(self):\n",
    "        display(self.root)\n",
    "\n",
    "\n",
    "worklist = build_worklist(df, sheet_name)\n",
    "print(f\"{sheet_name}: {len(worklist)} decision(s) need a figure\")\n",
    "print(pd.Series([i[\"q\"] for i in worklist]).value_counts().to_string() if worklist else \"  (none)\")\n",
    "\n",
    "review = WorklistReview(worklist, sheet_name)\n",
    "review.show()"
   ]
  },
