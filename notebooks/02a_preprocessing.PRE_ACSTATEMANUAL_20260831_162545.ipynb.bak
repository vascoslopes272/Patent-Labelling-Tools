     "traceback": [
      "\u001b[0;31m---------------------------------------------------------------------------\u001b[0m",
      "\u001b[0;31mAssertionError\u001b[0m                            Traceback (most recent call last)",
      "Cell \u001b[0;32mIn[17], line 3\u001b[0m\n\u001b[1;32m      1\u001b[0m \u001b[38;5;66;03m# Commits the rule pipeline's changes to df and runs the report-only completeness\u001b[39;00m\n\u001b[1;32m      2\u001b[0m \u001b[38;5;66;03m# check (flags gaps, changes no labels). Runs BEFORE Section 5's review queue.\u001b[39;00m\n\u001b[0;32m----> 3\u001b[0m df \u001b[38;5;241m=\u001b[39m \u001b[43mpipeline\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mresult\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m      4\u001b[0m df \u001b[38;5;241m=\u001b[39m _check_label_completeness(df)\n\u001b[1;32m      6\u001b[0m \u001b[38;5;66;03m# Per-flag patent counts from the rule pipeline. Section 5 walks a separate,\u001b[39;00m\n\u001b[1;32m      7\u001b[0m \u001b[38;5;66;03m# codebook-driven queue (src/review_worklists.py); these flags are the rules' own\u001b[39;00m\n\u001b[1;32m      8\u001b[0m \u001b[38;5;66;03m# report and are carried into the export's pre_process_flags column.\u001b[39;00m\n",
      "Cell \u001b[0;32mIn[16], line 969\u001b[0m, in \u001b[0;36mRuleReviewPipeline.result\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m    968\u001b[0m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21mresult\u001b[39m(\u001b[38;5;28mself\u001b[39m) \u001b[38;5;241m-\u001b[39m\u001b[38;5;241m>\u001b[39m pd\u001b[38;5;241m.\u001b[39mDataFrame:\n\u001b[0;32m--> 969\u001b[0m     \u001b[38;5;28;01massert\u001b[39;00m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mfinished, \u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mFinish reviewing all rules in the widget first.\u001b[39m\u001b[38;5;124m\"\u001b[39m\n\u001b[1;32m    970\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39mdf\u001b[38;5;241m.\u001b[39mcopy()\n",
      "\u001b[0;31mAssertionError\u001b[0m: Finish reviewing all rules in the widget first."
     ]
