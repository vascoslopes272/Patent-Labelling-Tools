   "source": [
    "### Fill the `wingRel` gap — keyboard widget\n",
    "\n",
    "`boomN_wingRel` (\"where does this boom sit relative to its wing?\") was added to the\n",
    "wizard on 2026-08-07, after Batch_01 and Batch_05 were labelled. It is required for\n",
    "every boom group whose `attach` is *Wings*, which is why it dominates the blocker\n",
    "report — 102 of Batch_01's 149.\n",
    "\n",
    "One boom group at a time, every approved figure of the patent on screen.\n",
    "**1–6** answers and advances, **s** skips, **n**/**p** move, **u** undoes,\n",
    "**[** / **]** move the figure focus. Decisions land in\n",
    "`wingrel_decisions_<batch>.csv` as you go, so stopping loses nothing.\n",
    "Call `apply_wing_rel()` when you are done to write them into the corrected xlsx."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7b6685cd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Batch_01: 102 boom group(s) need wingRel\n",
      "98 already on the sheet, 98 answered in total of 102\n"
     ]
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "29fbcd16fb984a19a5c3fcab2a8bba6b",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "VBox(children=(HTML(value=\"<div style='font:600 15px sans-serif'>item <b>1</b> of <b>102</b> (all) &nbsp;·&nbs…"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "WING_REL = [(\"Fore\", \"Forward of the wing\"), (\"Aft\", \"Aft of the wing\"),\n",
    "            (\"Straddle\", \"Straddles the wing\"), (\"Bridge\", \"Bridges two wings\"),\n",
    "            (\"NA\", \"N/A\"), (\"Other\", \"Other\")]\n",
    "_WR_CSV = (Path(cfg[\"paths\"][\"base\"]) / \"data\" / \"03b_CONFORMED_legacy\" / \"proposals\"\n",
    "           / f\"wingrel_decisions_{sheet_name}.csv\")\n",
    "\n",
    "\n",
    "_WR_LOCK = _WR_CSV.with_name(_WR_CSV.stem + \".LOCKED.sha256\")\n",
    "\n",
    "\n",
    "def _wr_hash(path: Path) -> str:\n",
    "    import hashlib\n",
    "    return hashlib.sha256(path.read_bytes()).hexdigest()\n",
    "\n",
    "\n",
    "def wing_rel_locked() -> bool:\n",
    "    \"\"\"True once the answers are frozen. The lock is a hash sidecar plus chmod 444,\n",
    "    the same belt-and-braces the frozen human exports use: the file mode stops an\n",
    "    accidental write, and the hash proves nothing changed even if the mode is put\n",
    "    back by hand.\"\"\"\n",
    "    return _WR_LOCK.exists()\n",
    "\n",
    "\n",
    "def lock_wing_rel():\n",
    "    \"\"\"Freeze the answers — call this when the whole dataset is labelled.\n",
    "\n",
    "    After this the widget opens read-only and `_save()` refuses to write, so a\n",
    "    decision already made can never be silently changed. Reversible only through\n",
    "    unlock_wing_rel(), which is deliberately a separate, explicit call.\n",
    "    \"\"\"\n",
    "    if not _WR_CSV.exists():\n",
    "        print(f\"nothing to lock — {_WR_CSV.name} does not exist\"); return\n",
    "    if wing_rel_locked():\n",
    "        print(f\"already locked ({_WR_LOCK.name})\"); return\n",
    "    import os, stat\n",
    "    from datetime import datetime, timezone\n",
    "    n = len(pd.read_csv(_WR_CSV))\n",
    "    _WR_LOCK.write_text(f\"{_wr_hash(_WR_CSV)}  {_WR_CSV.name}\\n\"\n",
    "                        f\"locked_utc {datetime.now(timezone.utc).isoformat(timespec='seconds')}\\n\"\n",
    "                        f\"decisions  {n}\\n\")\n",
    "    os.chmod(_WR_CSV, stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)   # 444\n",
    "    print(f\"LOCKED — {n} decision(s) frozen, {_WR_CSV.name} is now read-only\")\n",
    "    print(f\"   hash in {_WR_LOCK.name}; re-run the widget cell to see it read-only\")\n",
    "\n",
    "\n",
    "def unlock_wing_rel(confirm: bool = False):\n",
    "    \"\"\"Re-open the answers for editing. Pass confirm=True — the friction is the point.\"\"\"\n",
    "    if not wing_rel_locked():\n",
    "        print(\"not locked\"); return\n",
    "    if not confirm:\n",
    "        print(\"refusing: call unlock_wing_rel(confirm=True) to re-open frozen decisions\")\n",
    "        return\n",
    "    import os, stat\n",
    "    recorded = _WR_LOCK.read_text().split()[0]\n",
    "    now = _wr_hash(_WR_CSV)\n",
    "    if recorded != now:\n",
    "        print(f\"⚠ the file changed since it was locked!\\n   locked: {recorded[:16]}…\"\n",
    "              f\"\\n   now   : {now[:16]}…\")\n",
    "    os.chmod(_WR_CSV, 0o644)\n",
    "    _WR_LOCK.unlink()\n",
    "    print(\"unlocked — editable again\")\n",
    "\n",
    "\n",
    "def build_wing_rel_queue(frame: pd.DataFrame) -> list:\n",
    "    \"\"\"Boom groups attached to Wings with no wingRel row yet — the wizard's own rule.\"\"\"\n",
    "    f = frame\n",
    "    att = f.loc[f[\"Field\"].astype(str).str.match(r\"boom\\d+_attach$\")]\n",
    "    # The value ALREADY on the sheet, so an answered group still shows up with its\n",
    "    # answer instead of vanishing (or, worse, reappearing as unanswered).\n",
    "    have = {(str(p), str(fl)): _strip_label(v) for p, fl, v in\n",
    "            zip(f.loc[f[\"Field\"].astype(str).str.contains(\"wingRel\"), \"Patent_ID\"],\n",
    "                f.loc[f[\"Field\"].astype(str).str.contains(\"wingRel\"), \"Field\"],\n",
    "                f.loc[f[\"Field\"].astype(str).str.contains(\"wingRel\"), \"Value\"])}\n",
    "    t2 = f.loc[(f[\"Section\"] == \"T2\")]\n",
    "    st = t2.loc[t2[\"Field\"] == \"status\"]\n",
    "    ok = {(str(p), str(sd)) for p, sd, v in\n",
    "          zip(st[\"Patent_ID\"], st[\"Sub_Dimension\"], st[\"Value\"].map(_strip_label)) if v == \"approved\"}\n",
    "    # A multi-architecture patent keeps its figures on the BASE id, each block\n",
    "    # tagged with the `arch` it depicts. Without carrying that through, the widget\n",
    "    # shows all five variants' drawings side by side with no way to tell which one\n",
    "    # belongs to the boom group being answered.\n",
    "    arch_of = {(str(p), str(sd)): _strip_label(v) for p, sd, v in\n",
    "               zip(t2.loc[t2[\"Field\"].astype(str) == \"arch\", \"Patent_ID\"],\n",
    "                   t2.loc[t2[\"Field\"].astype(str) == \"arch\", \"Sub_Dimension\"],\n",
    "                   t2.loc[t2[\"Field\"].astype(str) == \"arch\", \"Value\"])}\n",
    "    # keyed by BLOCK, not by row — a T2 block spans ~13 rows and appending per row\n",
    "    # listed the same drawing a dozen times over.\n",
    "    _seen = {}\n",
    "    for p, sd, ip in zip(t2[\"Patent_ID\"].astype(str), t2[\"Sub_Dimension\"].astype(str), t2[\"Image_Path\"]):\n",
    "        if (p, sd) in ok and pd.notna(ip):\n",
    "            _seen[(re.sub(r\"_arch\\d+$\", \"\", p), str(sd))] = dict(\n",
    "                path=str(ip), arch=arch_of.get((p, sd)),\n",
    "                name=str(sd).removeprefix(\"Image: \"))\n",
    "    figs = {}\n",
    "    for (base, _sd), rec in _seen.items():\n",
    "        figs.setdefault(base, []).append(rec)\n",
    "    for base in figs:                      # this variant's own drawings first\n",
    "        figs[base].sort(key=lambda r: (r[\"arch\"] is None, str(r[\"arch\"])))\n",
    "    q = []\n",
    "    for i, r in att.iterrows():\n",
    "        pid, fld = str(r[\"Patent_ID\"]), str(r[\"Field\"])\n",
    "        if not str(r[\"Value\"]).startswith(\"Wings\"):\n",
    "            continue\n",
    "        wr = fld.replace(\"_attach\", \"_wingRel\")\n",
    "        q.append(dict(uid=f\"{pid}|{wr}\", patent=pid, field=wr,\n",
    "                      on_sheet=have.get((pid, wr)),\n",
    "                      group=fld.split(\"_\")[0], section=str(r[\"Section\"]),\n",
    "                      sub_dim=str(r[\"Sub_Dimension\"]),\n",
    "                      attach=str(r[\"Value\"]),\n",
    "                      arch=(m.group(1) if (m := re.search(r\"_arch(\\d+)$\", pid)) else None),\n",
    "                      figures=figs.get(re.sub(r\"_arch\\d+$\", \"\", pid), [])[:8]))\n",
    "    return q\n",
    "\n",
    "\n",
    "class WingRelReview:\n",
    "    \"\"\"One boom group at a time; answers are one keystroke and save immediately.\"\"\"\n",
    "\n",
    "    def __init__(self, items, csv_path):\n",
    "        self.items, self.csv, self.cur, self.focus = items, Path(csv_path), 0, 0\n",
    "        # Every item is ALWAYS in the queue and ALWAYS editable — answering does not\n",
    "        # remove it from view, it just moves you on. The toggle can narrow to the\n",
    "        # unanswered ones for a final sweep.\n",
    "        self.include_done = True\n",
    "        self.locked = wing_rel_locked()\n",
    "        self.decisions = {}\n",
    "        # Seed from what is already written on the sheet, then let the decisions file\n",
    "        # override — so a group answered in an earlier session opens with its answer.\n",
    "        self.decisions = {it[\"uid\"]: it[\"on_sheet\"] for it in items if it.get(\"on_sheet\")}\n",
    "        _from_sheet = len(self.decisions)\n",
    "        if self.csv.exists():\n",
    "            d = pd.read_csv(self.csv)\n",
    "            self.decisions.update(dict(zip(d.uid.astype(str), d.decision.astype(str))))\n",
    "        print(f\"{_from_sheet} already on the sheet, \"\n",
    "              f\"{len(self.decisions)} answered in total of {len(items)}\")\n",
    "        self.head, self.qbox, self.figbox = widgets.HTML(), widgets.HTML(), widgets.Box(\n",
    "            layout=widgets.Layout(flex_flow=\"row wrap\", width=\"900px\"))\n",
    "        self.zoom = widgets.Box()\n",
    "        # Clickable buttons for everything the keys do. ipyevents only delivers\n",
    "        # keydown while the widget holds DOM focus, and in the VS Code notebook panel\n",
    "        # it may never get it — a keyboard-only widget is then unusable. Section 5\n",
    "        # has always had these; this one was missing them.\n",
    "        def _mk(label, cb, style=\"\", w=\"230px\"):\n",
    "            b = widgets.Button(description=label, button_style=style,\n",
    "                               layout=widgets.Layout(width=w))\n",
    "            b.on_click(lambda _b: cb())\n",
    "            return b\n",
    "        self.opt_btns = [_mk(f\"{lbl}\", (lambda v=oid: self.decide(v)))\n",
    "                         for n, (oid, lbl) in enumerate(WING_REL)]\n",
    "        self.skip_btn = _mk(\"skip\", lambda: self.decide(\"__skip__\"), \"warning\")\n",
    "        self.nav = widgets.HBox([\n",
    "            _mk(\"◀ Prev\", lambda: self.step(-1), \"\", \"110px\"),\n",
    "            _mk(\"Next ▶\", lambda: self.step(+1), \"\", \"110px\"),\n",
    "            _mk(\"↩ Undo\", lambda: self.undo(), \"\", \"110px\"),\n",
    "            _mk(\"🔍 Zoom\", lambda: self._zoom(), \"\", \"110px\")])\n",
    "        self.done_btn = _mk(\"☑ Showing all\", lambda: self.toggle_done(), \"\", \"230px\")\n",
    "        # Walking back with Prev from item 100 is not navigation. The jump box moves\n",
    "        # straight to a position in whichever queue is showing; the patent box finds\n",
    "        # a boom group by patent id. Both leave the decisions untouched.\n",
    "        self.jump = widgets.BoundedIntText(value=1, min=1, max=max(1, len(items)),\n",
    "                                           description=\"Go to #:\",\n",
    "                                           layout=widgets.Layout(width=\"150px\"),\n",
    "                                           style={\"description_width\": \"60px\"})\n",
    "        self.jump.observe(self._on_jump, names=\"value\")\n",
    "        self.find = widgets.Text(placeholder=\"patent id…\", description=\"Find:\",\n",
    "                                 layout=widgets.Layout(width=\"230px\"),\n",
    "                                 style={\"description_width\": \"60px\"})\n",
    "        self.find.observe(self._on_find, names=\"value\")\n",
    "        self.panel = widgets.VBox([self.qbox] + self.opt_btns +\n",
    "                          [self.skip_btn, self.nav, self.done_btn, self.jump, self.find],\n",
    "                                  layout=widgets.Layout(width=\"270px\", margin=\"0 0 0 12px\"))\n",
    "        self.root = widgets.VBox([self.head, widgets.HBox(\n",
    "            [widgets.VBox([self.figbox, self.zoom]), self.panel],\n",
    "            layout=widgets.Layout(align_items=\"flex-start\"))])\n",
    "        # NO KEYBOARD. ipyevents delivered one keydown to this handler several\n",
    "        # times over, so a single press answered 4 boom groups with the same value —\n",
    "        # measured at 8ms apart once decisions carried a timestamp, twice (24 answers\n",
    "        # discarded on 2026-08-31, then 4 more). Buttons cannot misfire, and every\n",
    "        # action has one. The keys were a speed-up that cost more than it saved.\n",
    "        self.render()\n",
    "\n",
    "    def todo(self): return [i for i in self.items if i[\"uid\"] not in self.decisions]\n",
    "\n",
    "    def queue(self):\n",
    "        \"\"\"What Prev/Next walks: the unanswered items, or every item when\n",
    "        'Include answered' is on — so an answer can be revisited and changed.\n",
    "        Without this there was no way back to something already answered.\"\"\"\n",
    "        return list(self.items) if self.include_done else self.todo()\n",
    "\n",
    "    def item(self):\n",
    "        q = self.queue()\n",
    "        if not q:\n",
    "            return None\n",
    "        self.cur = max(0, min(self.cur, len(q) - 1))\n",
    "        return q[self.cur]\n",
    "\n",
    "    def _save(self):\n",
    "        if self.locked:\n",
    "            print(\"decisions are LOCKED — call unlock_wing_rel(confirm=True) to edit\")\n",
    "            return\n",
    "        self.csv.parent.mkdir(parents=True, exist_ok=True)\n",
    "        # decided_at makes a burst visible after the fact: several answers landing\n",
    "        # milliseconds apart is one keypress reaching the handler repeatedly, not a\n",
    "        # person. The first 24 answers here had no timestamp and had to be discarded.\n",
    "        now = pd.Timestamp.utcnow().isoformat()\n",
    "        prev = {}\n",
    "        if self.csv.exists():\n",
    "            _p = pd.read_csv(self.csv)\n",
    "            if \"decided_at\" in _p.columns:\n",
    "                prev = dict(zip(_p.uid.astype(str), _p.decided_at.astype(str)))\n",
    "        pd.DataFrame([dict(uid=u, decision=v, decided_at=now if u == getattr(self, '_stamp', None) else prev.get(u, now))\n",
    "                      for u, v in self.decisions.items()]).to_csv(self.csv, index=False)\n",
    "\n",
    "    def decide(self, val):\n",
    "        it = self.item()\n",
    "        if it is None: return\n",
    "        self.decisions[it[\"uid\"]] = val\n",
    "        self._stamp = it[\"uid\"]          # this one is new/changed: restamp it\n",
    "        self._save()\n",
    "        if self.include_done and self.cur < len(self.queue()) - 1:\n",
    "            self.cur += 1                # it stays in the list, so step on ourselves\n",
    "            self.focus = 0\n",
    "        self.render()\n",
    "\n",
    "    def step(self, d):\n",
    "        q = self.queue()\n",
    "        if q: self.cur = max(0, min(self.cur + d, len(q) - 1))\n",
    "        self.focus = 0\n",
    "        self.render()\n",
    "\n",
    "    def _on_jump(self, change):\n",
    "        if getattr(self, \"_syncing\", False):\n",
    "            return\n",
    "        q = self.queue()\n",
    "        if q:\n",
    "            self.cur = max(0, min(int(change[\"new\"]) - 1, len(q) - 1))\n",
    "            self.focus = 0\n",
    "            self.render()\n",
    "\n",
    "    def _on_find(self, change):\n",
    "        \"\"\"Jump to the first boom group of a patent, switching Include answered on\n",
    "        so an already-answered one is still reachable.\"\"\"\n",
    "        s = str(change[\"new\"]).strip().lower()\n",
    "        if not s:\n",
    "            return\n",
    "        hit = next((n for n, it in enumerate(self.items)\n",
    "                    if s in it[\"patent\"].lower()), None)\n",
    "        if hit is None:\n",
    "            return\n",
    "        if not self.include_done:\n",
    "            self.toggle_done(True)\n",
    "        q = [it[\"uid\"] for it in self.queue()]\n",
    "        self.cur = q.index(self.items[hit][\"uid\"])\n",
    "        self.focus = 0\n",
    "        self.render()\n",
    "\n",
    "    def toggle_done(self, on=None):\n",
    "        \"\"\"Flip 'Include answered', keeping the item on screen where possible.\"\"\"\n",
    "        it = self.item()\n",
    "        self.include_done = (not self.include_done) if on is None else bool(on)\n",
    "        uids = [x[\"uid\"] for x in self.queue()]\n",
    "        self.cur = uids.index(it[\"uid\"]) if it is not None and it[\"uid\"] in uids else 0\n",
    "        self.done_btn.description = (f\"☑ Showing all {len(self.items)}\"\n",
    "                                     if self.include_done else \"☐ Unanswered only\")\n",
    "        self.render()\n",
    "\n",
    "    def undo(self):\n",
    "        if self.decisions:\n",
    "            self.decisions.pop(list(self.decisions)[-1]); self._save(); self.render()\n",
    "\n",
    "    def _zoom(self):\n",
    "        it = self.item()\n",
    "        if it and it[\"figures\"]:\n",
    "            p = Path(it[\"figures\"][self.focus][\"path\"])\n",
    "            self.zoom.children = ([widgets.Image(value=p.read_bytes(),\n",
    "                                   format=p.suffix.lstrip(\".\") or \"png\",\n",
    "                                   layout=widgets.Layout(width=\"880px\"))] if p.exists() else ())\n",
    "\n",
    "    def render(self):\n",
    "        it, left, tot = self.item(), len(self.queue()), len(self.items)\n",
    "        if it is None:\n",
    "            self.head.value = (f\"<h3 style='font-family:sans-serif'>Done — \"\n",
    "                               f\"{len(self.decisions)} of {tot} answered.</h3>\"\n",
    "                               f\"<div style='color:#666'>Run <code>apply_wing_rel()</code> \"\n",
    "                               f\"to write them into the working copy.</div>\")\n",
    "            self.figbox.children, self.qbox.value = (), \"\"\n",
    "            for b in self.opt_btns + [self.skip_btn]:\n",
    "                b.disabled = True\n",
    "            return\n",
    "        # POSITION, not progress. This used to read `tot-left+1` — the number\n",
    "        # ANSWERED — so navigating with Next moved the patent while the counter sat\n",
    "        # frozen on the same number. Two separate facts, shown separately.\n",
    "        _ans = self.decisions.get(it[\"uid\"])\n",
    "        for _b in self.opt_btns + [self.skip_btn, self.nav.children[2]]:\n",
    "            _b.disabled = self.locked          # answers + Undo frozen; navigation stays\n",
    "        for _n, (_oid, _lbl) in enumerate(WING_REL):\n",
    "            self.opt_btns[_n].description = (\"● \" if _oid == _ans else \"\") + _lbl\n",
    "            self.opt_btns[_n].button_style = \"success\" if _oid == _ans else \"\"\n",
    "        self.skip_btn.description = \"● skip\" if _ans == \"__skip__\" else \"skip\"\n",
    "        _lock = (\"<div style='background:#fef3c7;border-left:4px solid #f59e0b;\"\n",
    "                 \"padding:6px 10px;font:600 13px sans-serif;margin-bottom:6px'>\"\n",
    "                 \"🔒 LOCKED — these answers are frozen and cannot be changed. \"\n",
    "                 \"unlock_wing_rel(confirm=True) to re-open.</div>\" if self.locked else \"\")\n",
    "        self.head.value = (_lock + f\"<div style='font:600 15px sans-serif'>\"\n",
    "                           f\"item <b>{self.cur+1}</b> of <b>{left}</b>{' (all)' if self.include_done else ' still to answer'} \"\n",
    "                           f\"&nbsp;·&nbsp; <span style='color:#666;font-weight:400'>\"\n",
    "                           f\"{len(self.decisions)} of {tot} done</span> &nbsp;·&nbsp; \"\n",
    "                           f\"<span style='font-family:monospace'>{it['patent']}</span> &middot; \"\n",
    "                           f\"{it['group']}\"\n",
    "                           + (f\" &middot; <b style='color:#15803d'>architecture \"\n",
    "                              f\"{it['arch']}</b> (figures ringed green)\" if it['arch'] else \"\")\n",
    "                           + \"</div>\"\n",
    "                           f\"<div style='color:#666;font-size:13px'>\"\n",
    "                           f\"attach = {it['attach']} &nbsp;·&nbsp; \"\n",
    "                           + (f\"<b style='color:#15803d'>answered: \"\n",
    "                              f\"{dict(WING_REL).get(_ans, _ans)}</b> — click another to change\"\n",
    "                              if _ans else \"<b style='color:#b45309'>not answered</b>\")\n",
    "                           + \"</div>\")\n",
    "        kids = []\n",
    "        for n, f in enumerate(it[\"figures\"]):\n",
    "            p = Path(f[\"path\"])\n",
    "            if not p.exists(): continue\n",
    "            mine = it[\"arch\"] is not None and f[\"arch\"] == it[\"arch\"]\n",
    "            tag = (f\"arch {f['arch']}\" if f[\"arch\"] else \"arch —\")\n",
    "            cap = (f\"<div style='font:600 12px sans-serif;text-align:center;\"\n",
    "                   f\"color:{'#15803d' if mine else '#9ca3af'}'>\"\n",
    "                   f\"{'✔ ' if mine else ''}{tag}</div>\"\n",
    "                   f\"<div style='font:10px monospace;text-align:center;color:#9ca3af;\"\n",
    "                   f\"width:280px;word-break:break-all'>{f['name'][:44]}</div>\")\n",
    "            kids.append(widgets.VBox(\n",
    "                [widgets.Image(value=p.read_bytes(), format=p.suffix.lstrip(\".\") or \"png\",\n",
    "                               layout=widgets.Layout(width=\"280px\", height=\"auto\")),\n",
    "                 widgets.HTML(cap)],\n",
    "                layout=widgets.Layout(margin=\"4px\", border=(\n",
    "                    \"3px solid #15803d\" if mine else\n",
    "                    (\"2px solid #1f77b4\" if n == self.focus else \"1px solid #ddd\")))))\n",
    "        self.figbox.children = tuple(kids) or (widgets.HTML(\"<i>no approved figure on disk</i>\"),)\n",
    "        self._syncing = True\n",
    "        self.jump.max = max(1, len(self.queue()))\n",
    "        self.jump.value = min(self.cur + 1, self.jump.max)\n",
    "        self._syncing = False\n",
    "        self.qbox.value = (\"<div style='font:600 14px sans-serif;margin-bottom:6px'>\"\n",
    "                           \"Where does this boom group sit relative to its wing?</div>\"\n",
    "                           \"<div style='color:#666;font-size:12px;margin-bottom:4px'>\"\n",
    "                           \"click one</div>\")\n",
    "\n",
    "    def show(self): display(self.root)\n",
    "\n",
    "\n",
    "def apply_wing_rel(frame: pd.DataFrame = None, write: bool = True) -> pd.DataFrame:\n",
    "    \"\"\"Write the recorded wingRel answers into the corrected working copy.\n",
    "\n",
    "    Each new row is cloned from that boom group's own `_attach` row, so it inherits\n",
    "    the patent's Section/Sub_Dimension exactly ('Boom Group 1' and\n",
    "    'Boom Group 1 -> M3 Type 1' both occur) and the wizard re-associates it on load.\n",
    "    \"\"\"\n",
    "    import shutil\n",
    "    from datetime import datetime, timezone\n",
    "    if not _WR_CSV.exists():\n",
    "        print(f\"no decisions at {_WR_CSV.name} — answer some first\"); return frame\n",
    "    dec = pd.read_csv(_WR_CSV)\n",
    "    dec = dec[dec.decision != \"__skip__\"]\n",
    "    target = Path(cfg[\"paths\"][\"corrected_wizard_exports\"]) / f\"reviewed_patents_{sheet_name}.xlsx\"\n",
    "    tgt = pd.read_excel(target, sheet_name=\"Review\")\n",
    "    lbl = dict(WING_REL)\n",
    "    stamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "    now = datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n",
    "    new_rows, log = [], []\n",
    "    for _, d in dec.iterrows():\n",
    "        pid, fld = str(d.uid).split(\"|\")\n",
    "        att = fld.replace(\"_wingRel\", \"_attach\")\n",
    "        src = tgt.loc[(tgt.Patent_ID.astype(str) == pid) & (tgt.Field.astype(str) == att)]\n",
    "        if not len(src):\n",
    "            print(f\"⚠ {pid}/{att} not found — skipped\"); continue\n",
    "        _ex = (tgt.Patent_ID.astype(str) == pid) & (tgt.Field.astype(str) == fld)\n",
    "        if _ex.any():                                  # already there — update it\n",
    "            _old = str(tgt.loc[_ex, \"Value\"].iloc[0])\n",
    "            _new = f\"{d.decision} — {lbl[d.decision]}\"\n",
    "            if _old != _new:\n",
    "                tgt.loc[_ex, \"Value\"] = _new\n",
    "                log.append(dict(applied_utc=now, batch=sheet_name, patent_id=pid,\n",
    "                                section=str(tgt.loc[_ex, \"Section\"].iloc[0]), field=fld,\n",
    "                                old_value=_old, new_value=_new,\n",
    "                                rule=\"wingRel changed\", evidence=\"answer revised in the widget\",\n",
    "                                confirmed_by=\"annotator (wingRel widget)\"))\n",
    "            continue\n",
    "        row = src.iloc[0].to_dict()\n",
    "        row.update(Field=fld, Value=f\"{d.decision} — {lbl[d.decision]}\")\n",
    "        new_rows.append(row)\n",
    "        log.append(dict(applied_utc=now, batch=sheet_name, patent_id=pid, section=row[\"Section\"],\n",
    "                        field=fld, old_value=\"(absent)\", new_value=row[\"Value\"],\n",
    "                        rule=\"wingRel backfill (field added 2026-08-07)\",\n",
    "                        evidence=\"boom group attached to Wings; the wizard requires wingRel\",\n",
    "                        confirmed_by=\"annotator (wingRel widget)\"))\n",
    "    if wing_rel_locked():\n",
    "        rec = _WR_LOCK.read_text().split()[0]\n",
    "        if rec != _wr_hash(_WR_CSV):\n",
    "            raise AssertionError(f\"{_WR_CSV.name} changed since it was locked — refusing \"\n",
    "                                 f\"to apply. Locked hash {rec[:16]}…, file now \"\n",
    "                                 f\"{_wr_hash(_WR_CSV)[:16]}…\")\n",
    "        print(\"(locked — hash verified)\")\n",
    "    if not new_rows and not log:\n",
    "        print(\"nothing to write — the sheet already matches your answers\"); return frame\n",
    "    if not new_rows:\n",
    "        shutil.copy2(target, target.with_name(f\"{target.stem}.PRE_WINGREL_{stamp}.xlsx\"))\n",
    "        tgt.to_excel(target, sheet_name=\"Review\", index=False)\n",
    "        pd.DataFrame(log).to_csv(Path(cfg[\"paths\"][\"corrected_wizard_exports\"]) / \"CORRECTIONS_LOG.csv\",\n",
    "                                 mode=\"a\", index=False, header=False)\n",
    "        print(f\"updated {len(log)} existing wingRel row(s) in {target.name}\")\n",
    "        return frame\n",
    "    print(f\"{len(new_rows)} wingRel row(s) to write\")\n",
    "    if not write:\n",
    "        return frame\n",
    "    shutil.copy2(target, target.with_name(f\"{target.stem}.PRE_WINGREL_{stamp}.xlsx\"))\n",
    "    out = pd.concat([tgt, pd.DataFrame(new_rows)], ignore_index=True)\n",
    "    out.to_excel(target, sheet_name=\"Review\", index=False)\n",
    "    lp = Path(cfg[\"paths\"][\"corrected_wizard_exports\"]) / \"CORRECTIONS_LOG.csv\"\n",
    "    pd.DataFrame(log).to_csv(lp, mode=\"a\", index=False,\n",
    "                             header=not lp.exists() or lp.stat().st_size == 0)\n",
    "    print(f\"wrote {target.name} ({len(out)} rows, backup PRE_WINGREL_{stamp})\")\n",
    "    if frame is not None:\n",
    "        frame = pd.concat([frame, pd.DataFrame(new_rows).reindex(columns=frame.columns)],\n",
    "                          ignore_index=True)\n",
    "        print(\"in-memory df updated too\")\n",
    "    return frame\n",
    "\n",
    "\n",
    "# Read the sheet, not df_raw: df_raw is the Section 3 load and never sees rows\n",
    "# written later by apply_wing_rel(), so the widget kept showing answered groups as\n",
    "# outstanding. Re-running this cell now always reflects the file.\n",
    "_wr_queue = build_wing_rel_queue(pd.read_excel(REVIEWED_XLSX, sheet_name=\"Review\"))\n",
    "print(f\"{sheet_name}: {len(_wr_queue)} boom group(s) need wingRel\"\n",
    "      + (\"   🔒 LOCKED\" if wing_rel_locked() else \"\"))\n",
    "if _wr_queue and not HEADLESS:\n",
    "    wing_rel_review = WingRelReview(_wr_queue, _WR_CSV)\n",
    "    wing_rel_review.show()\n",
    "elif not _wr_queue:\n",
    "    print(\"  none — nothing to fill\")\n"
   ]
  },
