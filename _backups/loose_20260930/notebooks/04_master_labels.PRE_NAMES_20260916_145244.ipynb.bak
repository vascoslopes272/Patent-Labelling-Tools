   "source": [
    "## 3 — Column registry\n",
    "\n",
    "What the master carries, in order, and what it deliberately drops. Patent-level fields are renamed\n",
    "to snake_case; G1–M3 keep the wizard's own Field names so the codebook maps 1:1."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0a65e383",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T21:28:22.207731Z",
     "iopub.status.busy": "2026-09-15T21:28:22.207594Z",
     "iopub.status.idle": "2026-09-15T21:28:22.213470Z",
     "shell.execute_reply": "2026-09-15T21:28:22.212964Z"
    }
   },
   "outputs": [],
   "source": [
    "# ── patent level (T1 + META), in output order: (wizard Field, master column) ──\n",
    "PATENT_COLS = [\n",
    "    (\"isApproved\", \"is_approved\"), (\"aircraftName\", \"aircraft_name\"), (\"assignee\", \"assignee\"),\n",
    "    (\"title\", \"title\"), (\"app_year\", \"app_year\"), (\"pub_year\", \"pub_year\"), (\"pdf_link\", \"pdf_link\"),\n",
    "    (\"archCount\", \"n_variants_declared\"),\n",
    "    (\"isDuplicate\", \"is_duplicate\"), (\"duplicateType\", \"dup_type\"), (\"duplicateId\", \"dup_of\"),\n",
    "    (\"t1DisapproveReason\", \"reason_human\"), (\"t1DisapproveReason_otherNote\", \"reason_note\"),\n",
    "    (\"imgNotReflect\", \"img_not_reflect\"),\n",
    "    (\"t1_humanUncertain\", \"t1_humanUncertain\"), (\"t1_uncertainNote\", \"t1_uncertainNote\"),\n",
    "    (\"t1_quickOverride\", \"t1_quickOverride\"), (\"t1_quickNote\", \"t1_quickNote\"),\n",
    "]\n",
    "# legacy name of reason_note on 4 Batch_05 records — merged into reason_note, never its own column\n",
    "LEGACY_MERGE = {\"disapproveOther\": \"reason_note\"}\n",
    "DROP_PATENT = {\"abstract\": \"long bibliographic text\", \"description_of_drawings\": \"long bibliographic text\",\n",
    "               \"scope\": \"unreviewed SBERT pre-label\", \"t1Field\": \"unreviewed SBERT pre-label\", \"t1Target\": \"unreviewed SBERT pre-label\",\n",
    "               \"labelToken\": \"SBERT token\", \"timestamp\": \"save stamp\", \"codebook_version\": \"schema stamp (user decision: not in the master)\",\n",
    "               \"familyId\": \"hardcoded placeholder\", \"mainFigure\": \"legacy patent-level flag, superseded by per-figure isMain\",\n",
    "               \"comments\": \"free text, not analysed\", \"patentImageComments\": \"free text, not analysed\"}\n",
    "# ── variant level (G1..M3): retired / structural fields that get no column ──\n",
    "DROP_VARIANT_RE = {r\"^longSym$\": \"retired v13\", r\"^empTiltsNote$\": \"retired v15.5\", r\"_symLong$\": \"retired v15.6\",\n",
    "                   r\"_symCirc$\": \"retired v15.6\", r\"^footAmbiguous$\": \"constant True\", r\"^boom\\d+_cards$\": \"structural marker\"}\n",
    "# ── canonical order inside each section (N-suffixed groups expand to the observed max) ──\n",
    "G1_ORDER = [\"topType\", \"notPureArch\", \"edgeTags\", \"edgeTags_wizard\",\n",
    "            \"uav_final\", \"uav_uncertain\", \"is_electric_final\", \"electric_uncertain\", \"electric_similar_final\",\n",
    "            \"takeoff_final\", \"takeoff_uncertain\", \"identity_from\", \"g1_humanUncertain\", \"g1_uncertainNote\", \"g1_quickOverride\", \"g1_quickNote\"]\n",
    "M1_FIXED = [\"fusShape\", \"fusShapeOtherNote\", \"fusKin\", \"gearArch\", \"latSym\", \"dinoUnderstanding\", \"boomsPresent\"]\n",
    "M1_BOOM  = [\"count\", \"attach\", \"attachOth\", \"wingRel\", \"wingRelOth\", \"wingIdx\", \"span\", \"long\", \"longOth\",\n",
    "            \"orient\", \"orientOth\", \"sym\", \"circSym\", \"hasProps\", \"tilts\", \"retracts\"]\n",
    "M1_TAIL  = [\"wingNotes\", \"boomNotes\", \"fusNotes\", \"empNotes\", \"gearNotes\", \"m1_humanUncertain\", \"m1_uncertainNote\", \"m1_quickOverride\"]\n",
    "M2_FIXED = [\"wingConf\", \"wingConfOtherNote\", \"wCount\", \"empType\", \"empTypeOtherNote\", \"empTilts\"]\n",
    "M2_WING  = [\"role\", \"role_otherNote\", \"tilt\", \"posV\", \"posL\", \"plan\", \"plan_otherNote\", \"tipJoin\"]\n",
    "M2_TAIL  = [\"m2_humanUncertain\", \"m2_uncertainNote\", \"m2_quickOverride\", \"m2_quickNote\"]\n",
    "M3_CARDS = [\"fuselage\", \"wing1\", \"wing2\", \"wing3\", \"emp\", \"boom\", \"core_layout\", \"hull_array\"]\n",
    "M3_CARD  = [\"count\", \"sym\", \"ntypes\", \"zone\", \"zoneChord\", \"zoneSpan\", \"quickOverride\", \"quickCount\", \"notes\",\n",
    "            \"chord\", \"orient\", \"bmech\", \"rmech\", \"propKin\", \"propKinOth\", \"ctrlOnly\"]         # the last 7: legacy single-type cards\n",
    "M3_TYPE  = [\"count\", \"chord\", \"orient\", \"bmech\", \"rmech\", \"propKin\", \"propKinOth\", \"ctrlOnly\", \"zone\", \"zoneChord\", \"zoneSpan\"]\n",
    "M3_TAIL  = [\"m3_humanUncertain\", \"m3_uncertainNote\"]\n",
    "COUNT_FIELDS_RE = re.compile(r\"(^|_)(count|ntypes|quickCount|wCount|archCount)$\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6e21fc97",
   "metadata": {},
   "source": [
    "## 4 — Pivot: patent-level table and variant-level table"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "134ff101",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T21:28:22.214789Z",
     "iopub.status.busy": "2026-09-15T21:28:22.214591Z",
     "iopub.status.idle": "2026-09-15T21:28:22.293545Z",
     "shell.execute_reply": "2026-09-15T21:28:22.292968Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "patent table (1639, 31)  variant table (909, 393)\n"
     ]
    }
   ],
   "source": [
    "def pivot(section_rows, index):\n",
    "    d = section_rows[[\"Patent_ID\", \"Field\", \"Value\"]].copy()\n",
    "    dup = d.duplicated([\"Patent_ID\", \"Field\"], keep=False)\n",
    "    if dup.any():\n",
    "        log(f\"  !! {dup.sum()} duplicated (id, Field) cells — keeping the LAST (file order); ids: \"\n",
    "            f\"{sorted(d[dup].Patent_ID.unique())[:8]}\")\n",
    "    return d.drop_duplicates([\"Patent_ID\", \"Field\"], keep=\"last\").pivot(index=\"Patent_ID\", columns=\"Field\", values=\"Value\")\n",
    "\n",
    "PT = pivot(L[L.Section.isin([\"T1\", \"META\"])], \"Patent_ID\")          # keyed on the BASE id\n",
    "VT = pivot(L[L.Section.isin([\"G1\", \"M1\", \"M2\", \"M3\"])], \"Patent_ID\") # keyed on the VARIANT id (bare or _archN)\n",
    "PT.index.name = VT.index.name = None\n",
    "assert all(base_id(p) == p for p in PT.index), \"T1/META rows on an _archN id\"\n",
    "batch_of = L.drop_duplicates(\"base\").set_index(\"base\").batch.to_dict()\n",
    "pos_of   = L.drop_duplicates(\"base\").set_index(\"base\")._pos.to_dict()\n",
    "\n",
    "# a patent with BOTH a bare-id morphology and _archN rows would be ambiguous — report, prefer _archN\n",
    "bare = {p for p in VT.index if arch_idx(p) == 1 and not p.endswith(\"_arch1\")}\n",
    "archd = {base_id(p) for p in VT.index if re.search(r\"_arch\\d+$\", p)}\n",
    "both = sorted(bare & archd)\n",
    "if both: log(f\"  !! {len(both)} patents carry morphology on the bare id AND on _archN ids (bare ignored): {both[:6]}\")\n",
    "VT = VT.drop(index=[p for p in both])\n",
    "log(f\"patent table {PT.shape}  variant table {VT.shape}\")\n",
    "var_ids = collections.defaultdict(list)\n",
    "for v in VT.index: var_ids[base_id(v)].append(v)\n",
    "for k in var_ids: var_ids[k].sort(key=arch_idx)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2df4aeb8",
   "metadata": {},
   "source": [
    "## 5 — Assemble one row per variant (rejected patents and label-less duplicates get an empty morphology)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "5bdf281b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T21:28:22.295020Z",
     "iopub.status.busy": "2026-09-15T21:28:22.294884Z",
     "iopub.status.idle": "2026-09-15T21:28:22.330704Z",
     "shell.execute_reply": "2026-09-15T21:28:22.330131Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  disapproveOther: 4 legacy notes merged into reason_note\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "master skeleton: 1750 rows (1639 patents), 382 variant columns kept, dropped ['boom1_cards', 'boom2_cards', 'boom3_cards', 'boom4_cards', 'boom5_cards', 'boom6_cards', 'boom_symCirc', 'boom_symLong', 'empTiltsNote', 'footAmbiguous', 'longSym']\n"
     ]
    }
   ],
   "source": [
    "patent_cols = [c for c, _ in PATENT_COLS]\n",
    "rows = []\n",
    "for pid in PT.index:\n",
    "    variants = var_ids.get(pid, [])\n",
    "    if not variants:\n",
    "        rows.append(dict(patent_id=pid, variant=1, variant_id=pid, n_variants=0))\n",
    "    for v in variants:\n",
    "        rows.append(dict(patent_id=pid, variant=arch_idx(v), variant_id=v, n_variants=len(variants)))\n",
    "M = pd.DataFrame(rows)\n",
    "M[\"batch\"] = M.patent_id.map(batch_of)\n",
    "for src, dst in PATENT_COLS:\n",
    "    M[dst] = M.patent_id.map(PT[src]) if src in PT.columns else np.nan\n",
    "for src, dst in LEGACY_MERGE.items():\n",
    "    if src in PT.columns:\n",
    "        legacy = M.patent_id.map(PT[src]); fill = M[dst].map(is_empty) & ~legacy.map(is_empty)\n",
    "        M.loc[fill, dst] = legacy[fill]; log(f\"  {src}: {int(fill.sum())} legacy notes merged into {dst}\")\n",
    "variant_cols = [c for c in VT.columns if not any(re.search(p, c) for p in DROP_VARIANT_RE)]\n",
    "VTm = VT[variant_cols].reindex(M.variant_id)\n",
    "VTm.index = M.index\n",
    "M = pd.concat([M, VTm], axis=1)\n",
    "dropped_v = sorted(set(VT.columns) - set(variant_cols))\n",
    "log(f\"master skeleton: {len(M)} rows ({M.patent_id.nunique()} patents), {len(variant_cols)} variant columns kept, dropped {dropped_v}\")"
   ]
  },
  {
