      "         REJECTED_NO_REASON   CN106494614A                                                                                                                                                                                                     isApproved=False and no t1DisapproveReason                                                                                                                  open in the wizard, pick a disapproval reason, re-export\n",
      "REJECTED_CARRIES_MORPHOLOGY   CN113086184A                                                                                                                                                                                                           topType=MR, reason=No Aircraft Image                                                       record is rejected but still labelled — blanked in the master; decide whether the rejection or the labels are right\n",
      "REJECTED_CARRIES_MORPHOLOGY WO2023272353A1                                                                                                                                                                                                           topType=HB, reason=No Aircraft Image                                                       record is rejected but still labelled — blanked in the master; decide whether the rejection or the labels are right\n",
      "        OTHER_NOTE_UNTAGGED                                                                                                                                                                                                   wingConfOtherNote: 'rotors inside and allong the wing' (1x)                                                                                                                             add a row to notebooks/04_other_note_tags.csv\n",
      "        OTHER_NOTE_UNTAGGED                                                                                                                                                                                                                         wingConfOtherNote: 'in x format' (1x)                                                                                                                             add a row to notebooks/04_other_note_tags.csv\n",
      "      IDENTITY_DUP_CONFLICT US2012061526A1                                                                                                                                                                          is_electric_final (aircraft 1): US2018163795A1=Yes; US2019308738A1=No reviewed duplicates of one aircraft answered differently — each keeps its own answer and the contested tag does not spread to the group; settle it in the identity review\n",
      "      IDENTITY_DUP_CONFLICT US2015048213A1 takeoff_final (aircraft 1): US2018057148A1=VTOL; US2018057159A1=VTOL; US2018079485A1=VTOL; US2018079486A1=VTOL; US2018079493A1=V/STOL; US2018079499A1=VTOL; US2018079500A1=VTOL; US2018079501A1=VTOL; US2018079502A1=VTOL; US2019092485A1=VTOL reviewed duplicates of one aircraft answered differently — each keeps its own answer and the contested tag does not spread to the group; settle it in the identity review\n",
      "\n",
      "informational:\n",
      "                    flag        patent_id                                                                                                                             detail\n",
      "  D1_OVERWRITTEN_BY_ROOT     CN114954905A                                                3 cells differed from root CN114449860A: wing1_zoneChord, wing1_zoneSpan, wingNotes\n",
      "  D1_OVERWRITTEN_BY_ROOT DE102023122141A1                                                                          1 cells differed from root DE102023108565B3: wing1_orient\n",
      "  D1_OVERWRITTEN_BY_ROOT DE102024105439A1                                                                          1 cells differed from root DE102023108565B3: wing1_orient\n",
