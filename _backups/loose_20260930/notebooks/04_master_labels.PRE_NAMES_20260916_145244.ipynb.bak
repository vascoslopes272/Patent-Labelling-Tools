    "## 2 — Wizard schema (option ids + display names) for the data dictionary and value checks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "88134b75",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T21:28:22.106394Z",
     "iopub.status.busy": "2026-09-15T21:28:22.106254Z",
