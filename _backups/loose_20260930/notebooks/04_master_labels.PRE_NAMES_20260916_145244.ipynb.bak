    "## 10 — Disapproval reason: the human/SBERT precedence switch and the disagreement report"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "1e5e330f",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T21:29:15.402317Z",
     "iopub.status.busy": "2026-09-15T21:29:15.402173Z",
     "iopub.status.idle": "2026-09-15T21:29:15.409686Z",
